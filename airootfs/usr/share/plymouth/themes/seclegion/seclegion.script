# SecLegion OS Plymouth Script
# Palette: #050F0E (Obsidian), #00FF88 (Matrix Green), #00F0FF (Cyber Cyan)

# Background
bg_image = Image("seclegion-wallpaper.png");
if (bg_image) {
    resized_bg = bg_image.Scale(Window.GetWidth(), Window.GetHeight());
    bg_sprite = Sprite(resized_bg);
    bg_sprite.SetZ(-10);
} else {
    Window.SetBackgroundTopColor(0.02, 0.06, 0.05);
    Window.SetBackgroundBottomColor(0.02, 0.06, 0.05);
}

# Spinner / Emblem
logo_image = Image("seclegion-spinner.png");
if (logo_image) {
    logo_sprite = Sprite(logo_image);
    logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
    logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2);
    logo_sprite.SetZ(10);
}

# Message Display
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetWidth() / 2 - 150, Window.GetHeight() * 0.82, 100);

fun message_callback (text) {
    my_image = Image.Text(text, 0.0, 1.0, 0.53);
    message_sprite.SetImage(my_image);
}

Plymouth.SetMessageFunction(message_callback);
