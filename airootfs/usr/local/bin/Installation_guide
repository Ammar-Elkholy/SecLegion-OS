#!/usr/bin/env bash
# ==============================================================================
# Installation_guide — SecLegion OS Setup Assistant
# SecLegion Edition | Ammar Elkholy
# ==============================================================================

CYAN="\033[1;36m"
GREEN="\033[1;32m"
BLUE="\033[1;34m"
YELLOW="\033[1;33m"
WHITE="\033[1;37m"
DIM="\033[2;37m"
RESET="\033[0m"

clear
echo -e "${CYAN}====================================================================${RESET}"
echo -e "${CYAN} █${GREEN}  ██████ ███████  ██████     ${CYAN}SECLEGION OS  █${RESET}"
echo -e "${CYAN} █${GREEN}  ██     ██      ██          ${CYAN}SecLegion Ed.  █${RESET}"
echo -e "${CYAN} █${GREEN}  ███████ █████  ██          ${DIM}by Ammar Elkholy${CYAN} █${RESET}"
echo -e "${CYAN} █${GREEN}       ██ ██     ██                         █${RESET}"
echo -e "${CYAN} █${GREEN}  ███████ ███████  ██████                   █${RESET}"
echo -e "${CYAN}====================================================================${RESET}"
echo -e " ${WHITE}Welcome to the SecLegion OS Installation & Setup Center.${RESET}"
echo -e " ${DIM}Universal installer for AMD, Intel, and NVIDIA systems.${RESET}"
echo -e "${CYAN}--------------------------------------------------------------------${RESET}"

# Network status check
if ping -c 1 -W 2 1.1.1.1 &>/dev/null; then
    echo -e " Network Status: ${GREEN}● ONLINE (Connected)${RESET}"
else
    echo -e " Network Status: ${YELLOW}○ OFFLINE (Run 'nmtui' to connect Wi-Fi)${RESET}"
fi

echo -e "${CYAN}--------------------------------------------------------------------${RESET}"
echo -e " ${WHITE}1)${RESET} Launch Calamares Graphical Installer ${GREEN}[Recommended GUI]${RESET}"
echo -e " ${WHITE}2)${RESET} Launch Guided CLI Installer (${CYAN}archinstall${RESET})"
echo -e " ${WHITE}3)${RESET} Connect to Wi-Fi (${YELLOW}nmtui${RESET})"
echo -e " ${WHITE}4)${RESET} Rank Fast Pacman Mirrors (${YELLOW}choose-mirror${RESET})"
echo -e " ${WHITE}5)${RESET} Test Audio System (${YELLOW}livecd-sound${RESET})"
echo -e " ${WHITE}6)${RESET} View Hardware & GPU Driver Info"
echo -e " ${WHITE}7)${RESET} USB-less Disk-to-Disk Installer (${CYAN}install-from-existing.sh${RESET})"
echo -e " ${WHITE}0)${RESET} Exit to Shell"
echo -e "${CYAN}--------------------------------------------------------------------${RESET}"
read -rp " Select an option [1-7, 0]: " choice

case "$choice" in
    1)
        echo -e "${GREEN}Starting Calamares GUI Installer...${RESET}"
        if command -v calamares &>/dev/null; then
            sudo -E calamares &
        else
            echo -e "${YELLOW}Calamares not found. Launching guided terminal installer (archinstall)...${RESET}"
            archinstall
        fi
        ;;
    2)
        archinstall
        ;;
    3)
        nmtui
        ;;
    4)
        choose-mirror
        ;;
    5)
        livecd-sound
        ;;
    6)
        echo -e "${CYAN}=== Graphics & Hardware Detection ===${RESET}"
        lspci -k | grep -A 2 -E "(VGA|3D)" || true
        echo -e "\nPress Enter to return..."; read -r
        exec "$0"
        ;;
    7)
        install-from-existing.sh
        ;;
    0)
        echo -e "${BLUE}Exiting to shell. Happy hacking!${RESET}"
        exit 0
        ;;
    *)
        exec "$0"
        ;;
esac
