/* Allow users in libvirt, kvm, and wheel groups to manage libvirt without authentication */
polkit.addRule(function(action, subject) {
    if (action.id == "org.libvirt.unix.manage" &&
        (subject.isInGroup("libvirt") || subject.isInGroup("kvm") || subject.isInGroup("wheel"))) {
        return polkit.Result.YES;
    }
});
