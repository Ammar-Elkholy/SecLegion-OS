{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 10
    },
    "separator": ""
  },
  "logo": {
    "type": "kitty-direct",
    "source": "/usr/share/pixmaps/seclegion-logo-transparent.png",
    "width": 26,
    "height": 13,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "command",
      "key": "󰀄 USER",
      "text": "echo $USER@$(hostnamectl hostname)"
    },
    {
      "type": "custom",
      "key": "󰣇 OS",
      "format": "SecLegion OS 2026.10 (Arch Linux Base)"
    },
    {
      "type": "command",
      "key": "󰌽 KER",
      "text": "echo $(uname -r | cut -d- -f1) $(uname -m)"
    },
    {
      "type": "packages",
      "key": "󰏗 PKG",
      "format": "{all}"
    },
    {
      "type": "terminal",
      "key": "󰆍 TERM",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "󰞷 SH",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "󰥔 UP"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "󰋊 SSD",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "custom",
      "format": "\u001b[32m \u001b[36m \u001b[92m \u001b[96m \u001b[97m \u001b[90m "
    },
    "break"
  ]
}
