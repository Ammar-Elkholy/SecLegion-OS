#
# Weekly trigger for seclegion-canary.service, for the OWNER's host only (see the service file).
[Unit]
Description=Weekly SecLegion vendor update canary

[Timer]
OnCalendar=weekly
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
