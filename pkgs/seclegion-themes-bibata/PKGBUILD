# Maintainer: SecLegion OS <https://github.com/seclegion>
#
# Bibata cursors (GPL-3.0), Modern Classic and Modern Ice, sizes 22 to 96 (24 included) in each
# Xcursor file. Upstream builds the cursors with python-clickgen and an SVG toolchain, none of
# which is in the Arch repositories, so this installs the upstream release assets (generated by
# upstream CI from the same tag) instead. Each asset is pinned by sha256 (docs/third-party.md);
# the licence comes from the tag's source tarball because the release assets do not carry it.
pkgname=seclegion-themes-bibata
pkgver=2.0.7
pkgrel=1
pkgdesc='Bibata Modern Classic and Modern Ice cursor themes (GPL-3.0), upstream release assets'
arch=('any')
url='https://github.com/ful1e5/Bibata_Cursor'
license=('GPL-3.0-only')
_rel="https://github.com/ful1e5/Bibata_Cursor/releases/download/v$pkgver"
source=("Bibata-Modern-Classic-$pkgver.tar.xz::$_rel/Bibata-Modern-Classic.tar.xz"
        "Bibata-Modern-Ice-$pkgver.tar.xz::$_rel/Bibata-Modern-Ice.tar.xz"
        "bibata-cursor-$pkgver.tar.gz::https://github.com/ful1e5/Bibata_Cursor/archive/refs/tags/v$pkgver.tar.gz")
noextract=("Bibata-Modern-Classic-$pkgver.tar.xz" "Bibata-Modern-Ice-$pkgver.tar.xz")
sha256sums=('7d3495864e5bbef02f5e77de760b2905903b63c71495a78ef6306d19a3b556d8'
            'a68cae60c4dc706350e194ebc91c5fe48bc7bc9d59e119555834a2a7ee5078ef'
            '1f21e5cade53d668476f973bd8ec827882a0e32c38e0e766abf007f8b3b46313')

package() {
    install -d "$pkgdir/usr/share/icons"
    local v
    for v in Classic Ice; do
        bsdtar -xf "$srcdir/Bibata-Modern-$v-$pkgver.tar.xz" -C "$pkgdir/usr/share/icons" --no-same-owner
    done
    chmod -R u+rwX,go+rX,go-w "$pkgdir/usr/share/icons"
    install -Dm644 "$srcdir/Bibata_Cursor-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
