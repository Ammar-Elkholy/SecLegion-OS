"""seclegion-firstboot: one-time setup on the first boot of an installed system.

1. snapper baseline snapshot `seclegion-baseline` (once);
2. Hyprland keyboard layout file from /etc/seclegion/keyboard-extra ("us" plus the extras);
3. leave /var/lib/seclegion/vendor-fetch-pending for the user's session: the vendor fetchers build with
   makepkg, which refuses root, and ask for the user's sudo password, so a root boot unit cannot run them;
4. write the done marker. A second run is a no-op. Offline never fails the unit.
Commands go through one injectable runner (argv, capture -> (returncode, stdout)); --root re-roots paths."""

import argparse
import os
import subprocess
import sys

BASELINE = "seclegion-baseline"
DONE = "var/lib/seclegion/firstboot.done"
KB_EXTRA = "etc/seclegion/keyboard-extra"
KB_LUA = "etc/seclegion/kb-layout.lua"
FETCHERS = ("seclegion-vscode-fetch", "seclegion-brave-fetch", "seclegion-claude-fetch")


def real_run(argv, capture=False):
    try:
        r = subprocess.run(argv, capture_output=capture, text=True, timeout=1800)
    except (OSError, subprocess.TimeoutExpired):
        return 127, ""
    return r.returncode, (r.stdout if capture else "")


def log(msg):
    print(f"seclegion-firstboot: {msg}", file=sys.stderr)


def layout(root):
    try:
        text = open(os.path.join(root, KB_EXTRA)).read()
    except OSError:
        text = ""
    extras = [x for x in (p.strip() for p in text.replace("\n", ",").split(",")) if x and x != "us"]
    ok = [x for x in extras if x.replace("_", "").replace("-", "").isalnum()]
    return ",".join(["us", *ok])


def write_layout(root):
    path = os.path.join(root, KB_LUA)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(
            # REUSE-IgnoreStart
            "-- SPDX-License-Identifier: MIT\n"
            # REUSE-IgnoreEnd
            "-- Generated by seclegion-firstboot from /etc/seclegion/keyboard-extra.\n"
            f'hl.config({{ input = {{ kb_layout = "{layout(root)}" }} }})\n'
        )


def baseline(run):
    rc, out = run(["snapper", "-c", "root", "list", "--columns", "description"], True)
    if rc == 0 and BASELINE in [ln.strip() for ln in out.split("\n")]:
        return
    cmd = ["snapper", "-c", "root", "create", "--description", BASELINE, "--cleanup-algorithm", "number"]
    if run(cmd, False)[0] != 0:
        log("could not create the baseline snapshot")


def main(argv=None, run=None):
    ap = argparse.ArgumentParser(prog="seclegion-firstboot")
    ap.add_argument("--root", default="/")
    a = ap.parse_args(argv)
    run = run or real_run
    done = os.path.join(a.root, DONE)
    if os.path.exists(done):
        return 0
    baseline(run)
    write_layout(a.root)
    pending = os.path.join(a.root, "var/lib/seclegion/vendor-fetch-pending")
    os.makedirs(os.path.dirname(pending), exist_ok=True)
    with open(pending, "w") as f:
        f.write("\n".join(FETCHERS) + "\n")
    log("vendor apps pending: the welcome app offers " + ", ".join(FETCHERS))
    os.makedirs(os.path.dirname(done), exist_ok=True)
    with open(done, "w") as f:
        f.write("done\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
