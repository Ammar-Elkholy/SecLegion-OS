"""gen-waybar-ws [-n N] [--check] - generate the workspace pills of the bar.

Waybar 0.15.0's hyprland/workspaces module dispatches the legacy
`workspace N` string, which Hyprland 0.56 in Lua mode rejects (clicks and
scrolls do nothing). The bar therefore uses custom/ws1 .. custom/wsN modules
(default N=20), each dispatching the Lua form. A module's exec only reads the
JSON seclegion-wsevents renders for it ($XDG_RUNTIME_DIR/seclegion/ws/N.json,
pills 1..20) and prints a hidden pill when the file is missing.

Reads  desktop/waybar/config.jsonc.in  (marker @WS_NAMES@ and line @WS_BLOCKS@)
       desktop/waybar/style.css.in     (marker line @WS_CSS@)
Writes desktop/waybar/config.jsonc and desktop/waybar/style.css, which are
committed so the host-apply diff is reviewable. --check writes nothing and
exits 1 if the committed files differ from what would be generated.
"""
import argparse
import json
import os
import sys

REPO = os.path.realpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
WAYBAR = os.path.join(REPO, "desktop", "waybar")
SIGNAL = 8
STATES = ("occupied", "empty", "active", "urgent", "hidden")
HIDDEN = '{"text":"","class":"hidden"}'


def read_pill(n):
    """The exec of pill n: one cat of a file seclegion-wsevents keeps current."""
    return "cat \"$XDG_RUNTIME_DIR/seclegion/ws/%d.json\" 2>/dev/null || echo '%s'" % (n, HIDDEN)


def lua_focus(ws):
    """The shell command that focuses a workspace: Hyprland 0.56 evaluates the
    dispatch argument as Lua (`return hl.dispatch(<arg>)`)."""
    return "hyprctl dispatch 'hl.dsp.focus({ workspace = \"%s\" })'" % ws


def module_block(n):
    props = [
        ("exec", read_pill(n)),
        ("return-type", "json"),
        ("interval", "once"),
        ("signal", SIGNAL),
        ("tooltip", False),
        ("on-click", lua_focus(n)),
        ("on-scroll-up", lua_focus("e-1")),
        ("on-scroll-down", lua_focus("e+1")),
    ]
    body = ",\n".join(f"    {json.dumps(k)}: {json.dumps(v)}" for k, v in props)
    return f'  "custom/ws{n}": {{\n{body}\n  }}'


def gen_config(template, n):
    names = ", ".join(f'"custom/ws{i}"' for i in range(1, n + 1))
    blocks = (
        "  // Workspace pills (generated by tools/gen-waybar-ws; edit config.jsonc.in).\n"
        + ",\n".join(module_block(i) for i in range(1, n + 1))
        + ","
    )
    if template.count("@WS_NAMES@") != 1 or template.count("  @WS_BLOCKS@,") != 1:
        raise SystemExit("config.jsonc.in must hold @WS_NAMES@ once and a line '  @WS_BLOCKS@,' once")
    out = template.replace("@WS_NAMES@", names).replace("  @WS_BLOCKS@,", blocks)
    return out.replace(
        "// TEMPLATE: tools/gen-waybar-ws turns this into config.jsonc (workspace pills).",
        "// GENERATED from config.jsonc.in by tools/gen-waybar-ws: edit the .in file, not this one.",
    )


def gen_css(template, n):
    def sel(suffix=""):
        return ",\n".join(f"#custom-ws{i}{suffix}" for i in range(1, n + 1))

    css = f"""/* Workspace pills: generated by tools/gen-waybar-ws from style.css.in
   (custom/ws1 .. custom/ws{n}; the class comes from seclegion-ws). */
{sel()} {{
  background-color: alpha(@sl_bg, 0.6);
  color: @sl_muted;
  border-radius: 8px;
  margin: 4px 2px;
  padding: 0 8px;
  transition: all 0.3s ease;
}}
{sel(":hover")} {{
  background-color: alpha(@sl_accent, 0.18);
  color: @sl_text;
  opacity: 1;
}}
{sel(".occupied")} {{
  color: @sl_text;
}}
{sel(".empty")} {{
  color: @sl_muted;
  opacity: 0.45;
}}
{sel(".active")} {{
  background-color: alpha(@sl_accent, 0.25);
  color: @sl_accent;
  opacity: 1;
}}
{sel(".urgent")} {{
  background-color: alpha(@sl_err, 0.45);
  color: @sl_text;
  opacity: 1;
}}
{sel(".hidden")} {{
  background: none;
  margin: 0;
  padding: 0;
  min-width: 0;
  opacity: 0;
}}"""
    if template.count("@WS_CSS@") != 1:
        raise SystemExit("style.css.in must hold the line @WS_CSS@ exactly once")
    return template.replace("@WS_CSS@", css)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("-n", type=int, default=20, help="number of workspace pills (default 20)")
    ap.add_argument("--check", action="store_true", help="only compare with the committed files")
    args = ap.parse_args(argv)
    if not 1 <= args.n <= 99:
        ap.error("-n must be 1..99")
    outputs = {}
    for name, fn in (("config.jsonc", gen_config), ("style.css", gen_css)):
        with open(os.path.join(WAYBAR, name + ".in")) as fh:
            outputs[name] = fn(fh.read(), args.n)
    rc = 0
    for name, text in outputs.items():
        path = os.path.join(WAYBAR, name)
        if args.check:
            try:
                with open(path) as fh:
                    same = fh.read() == text
            except OSError:
                same = False
            if not same:
                print(f"gen-waybar-ws: {path} is stale; run tools/gen-waybar-ws", file=sys.stderr)
                rc = 1
        else:
            with open(path, "w") as fh:
                fh.write(text)
            print(f"wrote {path}")
    return rc


if __name__ == "__main__":
    sys.exit(main())
