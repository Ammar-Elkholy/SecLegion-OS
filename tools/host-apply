# host-apply <border|notifications|waybar> | host-apply confirm
# Thin wrapper kept for the old name; the tool is tools/seclegion-host.
set -Eeuo pipefail
here="$(dirname "${BASH_SOURCE[0]}")"
case "${1:-}" in
    confirm) exec "$here/seclegion-host" confirm ;;
    *) exec "$here/seclegion-host" apply "$@" ;;
esac
