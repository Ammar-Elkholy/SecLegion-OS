# ini_set FILE SECTION KEY VALUE...: set KEY (one or several KEY=VALUE pairs of
# the one SECTION) in an INI file, touching nothing else: an existing key keeps
# its line position, a missing key goes at the end of its section, a missing
# section at the end of the file. The file is rewritten in place (inode, mode kept).
ini_set() {
    python3 - "$@" <<'PY'
import re, sys
path, section, pairs = sys.argv[1], sys.argv[2], [a.split("=", 1) for a in sys.argv[3:]]
try:
    text = open(path, encoding="utf-8").read()
except FileNotFoundError:
    text = ""
lines = text.splitlines(keepends=True)
if lines and not lines[-1].endswith("\n"):
    lines[-1] += "\n"
for key, val in pairs:
    head = f"[{section}]"
    start = next((i for i, l in enumerate(lines) if l.strip() == head), None)
    if start is None:
        if lines and lines[-1].strip():
            lines.append("\n")
        lines += [head + "\n", f"{key}={val}\n"]
        continue
    end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith("[")), len(lines))
    hit = next((i for i in range(start + 1, end) if re.match(rf"\s*{re.escape(key)}\s*=", lines[i])), None)
    if hit is not None:
        lines[hit] = f"{key}={val}\n"
    else:
        at = end
        while at > start + 1 and not lines[at - 1].strip():
            at -= 1
        lines.insert(at, f"{key}={val}\n")
new = "".join(lines)
if new != text:
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(new)
PY
}

# the [section] key=value pairs of an INI fragment, as "section<TAB>key=value"
ini_pairs() {
    python3 - "$1" <<'PY'
import sys
sec = None
for l in open(sys.argv[1], encoding="utf-8"):
    l = l.strip()
    if not l or l.startswith("#"):
        continue
    if l.startswith("[") and l.endswith("]"):
        sec = l[1:-1]
    elif sec and "=" in l:
        print(f"{sec}\t{l}")
PY
}

