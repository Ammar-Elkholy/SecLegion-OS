#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Ammar Elkholy and SecLegion contributors
# SPDX-License-Identifier: MIT
# seclegion-host - put one SecLegion desktop component onto the running host,
# with a backup, a 120 s dead-man rollback and a byte-exact undo.
#
#   seclegion-host apply <border|notifications|waybar|lock|keys|gtk|fm|settings|osd|idle|theme-auto|display>
#   seclegion-host confirm
#   seclegion-host rollback [--last|<id>|baseline-0]
#   seclegion-host prune --keep N
#   seclegion-host --system [--root DIR] (--home DIR | USER)
#
# The repo is the source of truth: a component is copied to
# ~/.local/share/seclegion/host/<component>/ and only the ~/.config/<x> symlink
# is flipped. Hyprland gets one require("seclegion-host") line plus
# ~/.config/hypr/seclegion-host.lua; autostart gets one dunst -> swaync edit;
# ~/.config/hypr/hyprlock.conf becomes a symlink to the installed lock screen
# (no reload: hyprlock reads it at lock time); ~/.config/hypr/seclegion-keys.lua
# becomes a symlink to the installed workspace keybinds, which the border's
# seclegion-host.lua loads (so keys needs border applied first), once
# tools/seclegion-keys-lint finds no collision with the owner's keybinds.lua
# and the live `hyprctl binds -j` (read-only). osd symlinks the dunstify shim
# (swaync replaces a popup for x-canonical-private-synchronous, not dunst's
# stack tag) and seclegion-osd into ~/.local/bin; no reload. The theme is never copied in by
# hand: when theme/current is not an engine symlink, `seclegion-theme reset
# --no-hooks` writes it (an old real directory is moved into the backup).
#
# apply: backup -> validate -> install -> reload that component -> arm the
# dead-man (systemd-run --user --on-active=120 <backup>/rollback.sh) -> verify.
# Any failure after the first change rolls back immediately.
#
# Backups: ~/.local/state/seclegion/host-backups/<UTC>-<component>/ (0700,
# files 0600): manifest.json, files.tar (only the touched paths, symlinks kept),
# dotfiles.patch (information only) and a generated, idempotent rollback.sh that
# needs neither the repo nor Wayland. baseline-0 (all components) is taken once,
# before the first change, and is never pruned; a component added to the tool
# later is merged into it before the next apply (extend_baseline).
#
# gtk: ~/.config/gtk-3.0/gtk.css and gtk-4.0/ (a real directory replacing the
# symlink into ~/.themes: nothing is ever written under ~/.themes or ~/.icons),
# the KDE and qt6ct colour-scheme symlinks, one key in kdeglobals. fm: Thunar as
# the inode/directory default, its status bar, Dolphin's, the yazi space plugin.
# Both only edit the keys they own; apps pick the change up on their next start.
# settings: the Settings app and CLI under host/settings/ (python/ holds the
# seclegion_settings and seclegion_theme packages, next to the launchers
# seclegion-set, seclegion-settings, seclegion-root-apply, seclegion-theme),
# the wrappers ~/.local/bin/seclegion-settings, seclegion-set and seclegion-theme, the rofi theme
# picker ~/.local/bin/seclegion-theme-pick (it runs the seclegion-theme wrapper beside it), the
# read-only ~/.local/bin/seclegion-doctor (a marked copy of tools/seclegion-doctor) and
# ~/.local/share/applications/seclegion-settings.desktop. Nothing is run as root:
# seclegion-root-apply is installed 0755 in a user-writable directory, so the
# owner must copy it to a root-owned path before running that copy with sudo.
# idle (apply idle): seclegion-autolock under host/idle/ with its hypridle.conf template,
# the user units seclegion-idle-inhibit.service and seclegion-idle.service, the symlink
# ~/.local/bin/seclegion-autolock and its state file ~/.config/seclegion/autolock. The
# owner's ~/.config/hypr/hypridle.conf is never read or written. Apply leaves the state
# as it was (default on a fresh host); rollback stops both units, removes everything above
# and starts again only what ran before the apply.
#
# theme-auto (apply theme-auto): the user units seclegion-theme-sync.path and .service under
# ~/.config/systemd/user, enabled and started (the path unit), and a private copy of seclegion-theme
# under host/theme-auto/ that the service runs as `sync`. Nothing starts a theme change until
# `seclegion-theme auto on`. Rollback disables and removes the units and the copy.
#
# display (apply display): seclegion-displayd under host/display/ (clears ghost monitors after an
# HDMI unplug; paints the background on every output through seclegion-wallpaper, issue 16) and its user unit seclegion-displayd.service, enabled on default.target and started:
# the live host never reaches graphical-session.target, where the packaged unit hangs. Hyprland is
# only read by apply (the daemon itself acts on an unplug). Rollback disables, stops and removes
# the unit and the copy, and starts the unit again only if an earlier apply had it running.
#
# waybar also symlinks the nm-applet shim (drops --indicator: no duplicate tray
# icon, the secret agent stays) into ~/.local/bin and restarts the running
# nm-applet through it, by pid; a rollback starts the recorded command again.
#
# --system: apply the PACKAGED components (seclegion-desktop, -theme, -settings, -branding under
# DIR/usr/share/seclegion, DIR/usr/lib/seclegion, DIR/usr/bin; DIR defaults to /) to the home of a NEW
# user, for the installer's post step. Hyprland is the only session: the user's hyprland.lua and
# hyprlock.conf come from /etc/skel and load the packaged border, keys and lock screen from /usr/share, so
# only the components that need a per-user copy are applied (notifications waybar gtk fm settings osd idle
# theme-auto). No Wayland, no Hyprland, no systemctl, no dead-man, no network: user units are enabled by
# creating the default.target.wants symlinks. It makes baseline-0 and one <UTC>-system backup, so
# `seclegion-host rollback` undoes it (a rollback of such a backup makes no live call). `--system USER` as root
# re-runs itself as USER (runuser) so the files belong to the user; as anyone else only your own user or --home.
# Refused: a home that has host-backups/baseline-0 of a live apply, host-pending or .config/hyprland-dotfiles
# (an owner's home), and --home equal to the invoking user's own home. A second run on an applied home is a
# no-op (roll back first to re-apply).
#
# Never runs sudo, never touches /etc, the display manager or Hyprland's
# process; signals only the affected daemons, by pid, for this uid.
# Tests: SL_HOME (fake home), SL_PROC (fake /proc) and PATH stubs.
set -Eeuo pipefail
shopt -s inherit_errexit
export LC_ALL=C
enable -n kill   # PATH kill: /usr/bin/kill on the host, a stub in tests

PROG=seclegion-host
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SL_SYSTEM_BACKUP="" SYS_ROOT=/ SYS_HOME="" SYS_USER=""
sys_args() {   # --system [--root DIR] (--home DIR | USER): sets SL_SYSTEM_BACKUP SYS_ROOT SYS_HOME; may re-exec as USER
    local pw uid real
    sys_fail() { printf '%s: ERROR: %s\n' "$PROG" "$*" >&2; exit 2; }
    while [ $# -gt 0 ]; do
        case "$1" in
            --root) [ $# -ge 2 ] || sys_fail "--root needs a directory"; SYS_ROOT="$2"; shift 2 ;;
            --home) [ $# -ge 2 ] || sys_fail "--home needs a directory"; SYS_HOME="$2"; shift 2 ;;
            -*) sys_fail "unknown option $1" ;;
            *) [ -z "$SYS_USER" ] || sys_fail "one USER only"; SYS_USER="$1"; shift ;;
        esac
    done
    if [ -z "$SYS_HOME$SYS_USER" ] || { [ -n "$SYS_HOME" ] && [ -n "$SYS_USER" ]; }; then sys_fail "usage: $PROG --system [--root DIR] (--home DIR | USER)"; fi
    SYS_ROOT="$(realpath -m -- "$SYS_ROOT")"
    uid="$(id -u)"
    if [ -n "$SYS_USER" ]; then
        pw="$(getent passwd "$SYS_USER")" || sys_fail "no such user: $SYS_USER"
        SYS_HOME="$(cut -d: -f6 <<< "$pw")"
        if [ "$uid" = 0 ]; then
            [ "$(cut -d: -f3 <<< "$pw")" != 0 ] || sys_fail "refusing root: that is not a new user's home"
            # root's session variables must not follow: XDG_RUNTIME_DIR=/run/user/0 made the theme lock
            # unwritable for the user (install post step), and a new home is never applied to a live session.
            exec runuser -u "$SYS_USER" -- env -u XDG_RUNTIME_DIR -u DBUS_SESSION_BUS_ADDRESS -u WAYLAND_DISPLAY \
                -u HYPRLAND_INSTANCE_SIGNATURE "$(realpath -- "${BASH_SOURCE[0]}")" --system --root "$SYS_ROOT" "$SYS_USER"
        fi
        [ "$(cut -d: -f3 <<< "$pw")" = "$uid" ] || sys_fail "run as root, or as $SYS_USER itself, for user $SYS_USER"
    else
        pw="$(getent passwd "$uid")" || pw=""
        real="$(cut -d: -f6 <<< "$pw")"
        if [ -n "$real" ] && [ "$(realpath -m -- "$SYS_HOME")" = "$(realpath -m -- "$real")" ]; then
            sys_fail "--home $SYS_HOME is the invoking user's own home; use a new user's home"
        fi
        if [ -n "${HOME:-}" ] && [ "$(realpath -m -- "$SYS_HOME")" = "$(realpath -m -- "$HOME")" ] \
            && [ -n "$(ls -A -- "$SYS_HOME" 2>/dev/null)" ]; then
            sys_fail "--home $SYS_HOME is the invoking user's \$HOME and is not empty"
        fi
    fi
    case "$SYS_HOME" in /?*) ;; *) sys_fail "the home must be an absolute path: $SYS_HOME" ;; esac
    SL_SYSTEM_BACKUP=1
}
if [ "${1:-}" = --system ]; then shift; sys_args "$@"; fi
HOME_DIR="${SYS_HOME:-${SL_HOME:-$HOME}}"
PROC="${SL_PROC:-/proc}"
CFG="$HOME_DIR/.config"
SHARE="$HOME_DIR/.local/share/seclegion"
INST="$SHARE/host"
STATE="$HOME_DIR/.local/state/seclegion"
BACKUPS="$STATE/host-backups"
PENDING="$STATE/host-pending"
THEME_DIR="$STATE/theme/current"
LOCK_CONF="$CFG/hypr/hyprlock.conf"
HYPR_MAIN="$CFG/hypr/hyprland.lua"
HYPR_AUTO="$CFG/hypr/modules/autostart.lua"
HYPR_KEYS="$CFG/hypr/modules/keybinds.lua"
KEYS_LINK="$CFG/hypr/seclegion-keys.lua"
KEYS_REQ_RE='^[^-]*pcall\(require, "seclegion-keys"\)'
DEADMAN=seclegion-host-deadman
WSEV_UNIT=seclegion-wsevents.service
NMA_REAL="${SL_NMAPPLET_REAL:-/usr/bin/nm-applet}"   # what the shim and a rollback run; SL_NMAPPLET_REAL: tests only
COMPONENTS=(border notifications waybar lock keys gtk fm settings osd)
COMPONENTS+=(idle)   # T13: no surprise lock
COMPONENTS+=(theme-auto)   # T11 J3: re-theme on a wallpaper change
COMPONENTS+=(display)   # issue 15: workspaces stranded on a ghost HDMI monitor
DSP_UNIT=seclegion-displayd.service
TA_PATH_UNIT=seclegion-theme-sync.path
TA_UNIT=seclegion-theme-sync.service
OSD_BINS=(dunstify seclegion-osd)
IDLE_UNIT=seclegion-idle.service
IDLE_INHIBIT_UNIT=seclegion-idle-inhibit.service
ID_RE='^[0-9]{8}T[0-9]{6}Z-[a-z-]+$'
DUNST_RE='^[[:space:]]*hl\.exec_cmd\("dunst"\)[[:space:]]*$'
SWAYNC_RE='^[[:space:]]*hl\.exec_cmd\("swaync"\)[[:space:]]*$'

# In a checkout the library is tools/host-lib.sh; the seclegion-desktop package installs it as
# /usr/lib/seclegion/host-lib.sh (and this script as /usr/bin/seclegion-host).
HOST_LIB="$REPO/tools/host-lib.sh"
[ -r "$HOST_LIB" ] || HOST_LIB="$REPO/lib/seclegion/host-lib.sh"
# shellcheck source=tools/host-lib.sh
. "$HOST_LIB"

session_env

phase=none BK="" STAGE=""
OWNER_COMM="" OWNER_ARGV=() WAYBAR_STATE="" NMA_RUN="" NMA_ARGS=() NMA_RESTARTED=""

on_fail() {
    local rc=$? line="${1:-?}"
    [ "$BASHPID" = "$$" ] || exit 1   # in a subshell: the parent's trap handles it
    trap - ERR INT TERM HUP
    set +e
    [ -z "$STAGE" ] || rm -rf -- "$STAGE"
    case "$phase" in
        backup)
            err "failed before any change (line $line, rc $rc); removing the partial backup $BK"
            rm -rf -- "$BK"
            ;;
        changed)
            err "FAILED at line $line (rc $rc); rolling back ${BK##*/} now"
            bash "$BK/rollback.sh" || err "ROLLBACK FAILED: run it by hand from a TTY: bash $BK/rollback.sh"
            ;;
        *) err "failed at line $line (rc $rc)" ;;
    esac
    exit 1
}
trap 'on_fail $LINENO' ERR
# A closed terminal or Ctrl-C mid-apply must roll back too, not leave a half-applied host.
trap 'on_fail $LINENO' INT TERM HUP

die() {
    err "$*"
    if [ "$phase" = backup ] || [ "$phase" = changed ]; then on_fail "${BASH_LINENO[0]}"; fi
    exit 1
}

usage() {
    sed -n '3,10s/^# \{0,1\}//p' "${BASH_SOURCE[0]}" >&2
    exit 2
}

is_component() {
    local c
    for c in "${COMPONENTS[@]}"; do [ "$c" = "$1" ] && return 0; done
    return 1
}

# HOME-relative paths a component touches; "shared" is only ever in baseline-0
comp_paths() {
    case "$1" in
        border) printf '%s\n' .config/hypr/hyprland.lua .config/hypr/seclegion-host.lua .local/share/seclegion/host/border ;;
        notifications) printf '%s\n' .config/hypr/modules/autostart.lua .config/swaync .local/share/seclegion/host/notifications ;;
        waybar)
            printf '%s\n' .config/waybar .local/share/seclegion/host/waybar .local/share/seclegion/host/bin \
                .config/systemd/user/seclegion-wsevents.service \
                .config/systemd/user/default.target.wants/seclegion-wsevents.service \
                .local/bin/nm-applet
            ;;
        lock) printf '%s\n' .config/hypr/hyprlock.conf .local/share/seclegion/host/lock ;;
        keys) printf '%s\n' .config/hypr/seclegion-keys.lua .local/share/seclegion/host/keys ;;
        idle)
            printf '%s\n' .local/share/seclegion/host/idle .local/bin/seclegion-autolock \
                .config/systemd/user/"$IDLE_INHIBIT_UNIT" .config/systemd/user/"$IDLE_UNIT" \
                .config/systemd/user/default.target.wants/"$IDLE_INHIBIT_UNIT" \
                .config/systemd/user/default.target.wants/"$IDLE_UNIT" \
                .config/seclegion/autolock .config/seclegion
            ;;
        theme-auto)
            printf '%s\n' .local/share/seclegion/host/theme-auto \
                .config/systemd/user/"$TA_PATH_UNIT" .config/systemd/user/"$TA_UNIT" \
                .config/systemd/user/default.target.wants/"$TA_PATH_UNIT"
            ;;
        display)
            printf '%s\n' .local/share/seclegion/host/display .config/systemd/user/"$DSP_UNIT" \
                .config/systemd/user/default.target.wants/"$DSP_UNIT" .local/bin/seclegion-display-menu
            ;;
        # children before the directories this apply may create: a rollback empties
        # and removes the directory only when it was absent and is empty again
        gtk)
            printf '%s\n' .config/gtk-3.0/gtk.css .config/gtk-3.0 .config/gtk-4.0 \
                .local/share/color-schemes/SecLegion.colors .local/share/color-schemes \
                .config/kdeglobals \
                .config/qt6ct/colors/SecLegion.conf .config/qt6ct/colors .config/qt6ct
            ;;
        fm)
            printf '%s\n' .config/mimeapps.list .config/dolphinrc \
                .config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml .config/xfce4/xfconf/xfce-perchannel-xml \
                .config/xfce4/xfconf .config/xfce4 \
                .config/yazi/plugins/seclegion-space.yazi/main.lua .config/yazi/plugins/seclegion-space.yazi \
                .config/yazi/plugins .config/yazi/init.lua .config/yazi \
                .local/share/seclegion/host/fm
            ;;
        settings)
            printf '%s\n' .local/share/seclegion/host/settings .local/bin/seclegion-settings .local/bin/seclegion-set \
                .local/bin/seclegion-theme .local/bin/seclegion-theme-pick .local/bin/seclegion-doctor .local/share/applications/seclegion-settings.desktop
            ;;
        osd) printf '%s\n' .local/share/seclegion/host/osd .local/bin/dunstify .local/bin/seclegion-osd ;;
        shared) printf '%s\n' .local/share/seclegion/seclegion-logo.png ;;
    esac
}
comp_daemons() {
    [ -z "$SL_SYSTEM_BACKUP" ] || return 0   # --system: no running daemon is recorded or touched
    case "$1" in
        notifications) printf '%s\n' dunst swaync ;;
        waybar) printf '%s\n' waybar ;;
    esac
}
comp_source() {
    case "$1" in
        border) echo desktop/hypr/seclegion-host.lua ;;
        notifications) echo desktop/swaync ;;
        waybar) echo desktop/waybar ;;
        lock) echo desktop/hypr/hyprlock.conf ;;
        keys) echo desktop/hypr/seclegion-keys.lua ;;
        idle) echo desktop/idle ;;
        theme-auto) echo desktop/theme/systemd ;;
        display) echo desktop/display ;;
        gtk) echo desktop/theme ;;
        fm) echo desktop/fm ;;
        settings) echo desktop/settings ;;
        osd) echo desktop/osd ;;
    esac
}

list_ids() {
    local d
    for d in "$BACKUPS"/*/; do
        d="${d%/}" d="${d##*/}"
        if [[ "$d" =~ $ID_RE ]]; then printf '%s\n' "$d"; fi
    done
    return 0
}

# <UTC>-<component>, strictly after every existing id: unique and chronological
new_id() {
    local id last
    last="$(list_ids | tail -n1)"
    while :; do
        id="$(date -u +%Y%m%dT%H%M%SZ)-$1"
        if [ -z "$last" ] || [[ "$id" > "$last" ]]; then
            printf '%s\n' "$id"
            return 0
        fi
        sleep 0.2
    done
}

q_array() {
    local a
    for a in "$@"; do printf '%q ' "$a"; done
}

count_lines() { grep -cE "$1" "$2" || true; }

# ---- backup -----------------------------------------------------------------
dotfiles_patch() {
    local dot="$CFG/hyprland-dotfiles" out
    echo "# Information only: rollback restores from files.tar, never from this patch."
    if [ ! -e "$dot/.git" ]; then
        echo "# $dot is not a git work tree"
        return 0
    fi
    echo "# git -C $dot diff"
    git --no-optional-locks -C "$dot" diff --no-ext-diff || echo "# (git diff failed)"
    echo "# untracked files (git status):"
    if out="$(git --no-optional-locks -C "$dot" status --porcelain --untracked-files=all)"; then
        printf '%s\n' "$out" | sed -n 's/^?? /# untracked: /p'
    else
        echo "# (git status failed)"
    fi
}

# rollback.sh for backup $1 in directory $2, from the caller's comps rels kinds sums
# arrays and OWNER_COMM OWNER_ARGV WAYBAR_STATE WSEV_STATE NMA_RUN NMA_ARGS IDLE_STATE IDLE_INHIBIT_STATE TA_STATE
# DSP_STATE
write_rollback() {
    local id="$1" BK="$2"
    {
        printf '#!/usr/bin/env bash\n'
        printf '# Generated by seclegion-host for backup %s. Idempotent; needs no repo and no Wayland.\n' "$id"
        printf '# Run from any TTY: bash %q\n' "$BK/rollback.sh"
        printf 'set -Eeuo pipefail\nshopt -s inherit_errexit\nexport LC_ALL=C\nPROG=rollback.sh\n'
        printf 'ID=%q\nBK=%q\nHOME_DIR=%q\nSTATE=%q\nDEADMAN=%q\n' "$id" "$BK" "$HOME_DIR" "$STATE" "$DEADMAN"
        # shellcheck disable=SC2016
        printf 'PROC="${SL_PROC:-/proc}"\n'
        printf 'COMPS=(%s)\nRELS=(%s)\nKINDS=(%s)\nSUMS=(%s)\n' "$(q_array "${comps[@]}")" \
            "$(q_array "${rels[@]}")" "$(q_array "${kinds[@]}")" "$(q_array "${sums[@]}")"
        printf 'OWNER_COMM=%q\nOWNER_ARGV=(%s)\nWAYBAR_STATE=%q\nWSEV_STATE=%q\nWSEV_UNIT=%q\n' "$OWNER_COMM" "$(q_array "${OWNER_ARGV[@]}")" \
            "$WAYBAR_STATE" "$WSEV_STATE" "$WSEV_UNIT"
        printf 'IDLE_UNIT=%q\nIDLE_INHIBIT_UNIT=%q\nIDLE_STATE=%q\nIDLE_INHIBIT_STATE=%q\n' "$IDLE_UNIT" "$IDLE_INHIBIT_UNIT" \
            "$IDLE_STATE" "$IDLE_INHIBIT_STATE"
        printf 'TA_PATH_UNIT=%q\nTA_UNIT=%q\nTA_STATE=%q\n' "$TA_PATH_UNIT" "$TA_UNIT" "$TA_STATE"
        printf 'DSP_UNIT=%q\nDSP_STATE=%q\n' "$DSP_UNIT" "$DSP_STATE"
        printf 'NMA_REAL=%q\nNMA_RUN=%q\nNMA_ARGS=(%s)\n' "$NMA_REAL" "$NMA_RUN" "$(q_array "${NMA_ARGS[@]}")"
        printf 'SL_SYSTEM_BACKUP=%s\n' "$SL_SYSTEM_BACKUP"   # always set, so an inherited env value never applies
        cat "$HOST_LIB"
        # shellcheck disable=SC2016
        printf '\nrollback_main "$@"\n'
    }
}

# nm-applet as it runs now (NMA_RUN 1 and its arguments, or 0): the waybar apply swaps it for the shim's
record_nm_applet() {
    local pid
    NMA_RUN=0 NMA_ARGS=()
    pid="$(pids_of nm-applet | head -n1)"
    if [ -n "$pid" ]; then
        NMA_RUN=1
        mapfile -t NMA_ARGS < <(proc_argv "$pid" | tail -n +2)
    fi
}

make_backup() {
    local id="$1" c d rel s pid opt v
    shift
    local comps=("$@") rels=() kinds=() sums=() present=() records=""
    BK="$BACKUPS/$id"
    phase=backup
    umask 077
    mkdir -p -- "$BACKUPS"
    mkdir -m 700 -- "$BK"
    for c in "${comps[@]}"; do mapfile -t -O "${#rels[@]}" rels < <(comp_paths "$c"); done
    for rel in "${rels[@]}"; do
        s="$(current_sum "$rel")"
        kinds+=("${s%% *}")
        sums+=("${s#* }")
        [ "${s%% *}" = absent ] || present+=("$rel")
        records+="path	$rel	${s%% *}	${s#* }"$'\n'
    done
    tar_paths "$BK/files.tar" "${present[@]}"
    dotfiles_patch > "$BK/dotfiles.patch"

    for c in "${comps[@]}"; do
        for d in $(comp_daemons "$c"); do
            records+="expect	$d"$'\n'
            for pid in $(pids_of "$d"); do
                records+="daemon	$d	$pid	$(proc_argv "$pid" | tr '\n' '\t')"$'\n'
            done
        done
    done
    OWNER_COMM="" OWNER_ARGV=() WAYBAR_STATE="" WSEV_STATE="" NMA_RUN="" NMA_ARGS=() IDLE_STATE="" IDLE_INHIBIT_STATE="" TA_STATE=""
    DSP_STATE=""
    if [ -z "$SL_SYSTEM_BACKUP" ] && [[ " ${comps[*]} " == *" notifications "* ]]; then
        pid="$(owner_pid)"
        if [ -n "$pid" ]; then
            OWNER_COMM="$(proc_comm "$pid")"
            mapfile -t OWNER_ARGV < <(proc_argv "$pid")
            records+="owner	$pid	$OWNER_COMM	$(proc_argv "$pid" | tr '\n' '\t')"$'\n'
        fi
    fi
    if [ -z "$SL_SYSTEM_BACKUP" ] && [[ " ${comps[*]} " == *" waybar "* ]]; then
        WAYBAR_STATE="$(systemctl --user is-active waybar 2>/dev/null)" || true
        records+="waybar	$WAYBAR_STATE"$'\n'
        WSEV_STATE="$(systemctl --user is-active "$WSEV_UNIT" 2>/dev/null)" || true
        records+="wsevents	$WSEV_STATE"$'\n'
        record_nm_applet
        records+="nm-applet	$NMA_RUN"$'\n'
    fi
    if [ -z "$SL_SYSTEM_BACKUP" ] && [[ " ${comps[*]} " == *" idle "* ]]; then
        IDLE_STATE="$(systemctl --user is-active "$IDLE_UNIT" 2>/dev/null)" || true
        IDLE_INHIBIT_STATE="$(systemctl --user is-active "$IDLE_INHIBIT_UNIT" 2>/dev/null)" || true
        records+="idle	$IDLE_STATE	$IDLE_INHIBIT_STATE"$'\n'
    fi
    if [ -z "$SL_SYSTEM_BACKUP" ] && [[ " ${comps[*]} " == *" theme-auto "* ]]; then
        TA_STATE="$(systemctl --user is-active "$TA_PATH_UNIT" 2>/dev/null)" || true
        records+="theme-auto	$TA_STATE"$'\n'
    fi
    if [ -z "$SL_SYSTEM_BACKUP" ] && [[ " ${comps[*]} " == *" display "* ]]; then
        DSP_STATE="$(systemctl --user is-active "$DSP_UNIT" 2>/dev/null)" || true
        records+="display	$DSP_STATE"$'\n'
    fi
    if has_hyprland; then
        for opt in general:col.active_border general:col.inactive_border general:border_size; do
            v="$(hyprctl -j getoption "$opt" 2>/dev/null | tr -d '\n')" || v=""
            records+="hyprctl	$opt	$v"$'\n'
        done
    fi

    python3 - "$BK/manifest.json" "$id" "$HOME_DIR" "$records" "${comps[@]}" <<'PY'
import datetime, json, sys
out, ident, home, records, comps = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:]
m = {"id": ident, "components": comps,
     "created_utc": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
     "home": home, "paths": [], "daemons": {}, "notifications_owner": None,
     "hyprctl": {}, "files_tar": "files.tar", "dotfiles_patch": "dotfiles.patch",
     "rollback": "rollback.sh"}
for line in records.splitlines():
    f = line.split("\t")
    if f[0] == "path":
        e = {"path": f"{home}/{f[1]}", "kind": f[2]}
        if f[2] == "file":
            e["sha256"] = f[3]
        elif f[2] == "symlink":
            e["symlink_target"] = f[3]
        m["paths"].append(e)
    elif f[0] == "expect":
        m["daemons"].setdefault(f[1], [])
    elif f[0] == "daemon":
        m["daemons"][f[1]].append({"pid": int(f[2]), "cmdline": [a for a in f[3:] if a]})
    elif f[0] == "owner":
        m["notifications_owner"] = {"pid": int(f[1]), "comm": f[2], "cmdline": [a for a in f[3:] if a]}
    elif f[0] == "waybar":
        m["waybar_service"] = f[1]
    elif f[0] == "wsevents":
        m["wsevents_service"] = f[1]
    elif f[0] == "idle":
        m["idle_service"] = f[1]
        m["idle_inhibit_service"] = f[2]
    elif f[0] == "theme-auto":
        m["theme_auto_path_unit"] = f[1]
    elif f[0] == "display":
        m["displayd_service"] = f[1]
    elif f[0] == "nm-applet":
        m["nm_applet_running"] = f[1] == "1"
    elif f[0] == "hyprctl":
        try:
            m["hyprctl"][f[1]] = json.loads(f[2])
        except ValueError:
            m["hyprctl"][f[1]] = f[2]
with open(out, "w") as fh:
    json.dump(m, fh, indent=2)
    fh.write("\n")
PY

    write_rollback "$id" "$BK" > "$BK/rollback.sh"
    bash -n "$BK/rollback.sh"
    chmod 600 "$BK"/*
    umask 022
    log "backup: $BK"
}

# baseline-0 is taken once, so a component (or path) added to the tool later is
# not in it, and `rollback baseline-0` would leave that component installed.
# Before every apply, each path of every component that baseline-0 lacks is
# merged into it with its state now (still untouched: no apply of it has run
# with this tool), and rollback.sh is regenerated with the merged arrays, so
# baseline-0 stays one byte-exact backup. The new files.tar (a superset) goes
# in first and rollback.sh last: an interrupted merge leaves a working baseline.
extend_baseline() {
    local b0="$BACKUPS/baseline-0" c rel s new=() newcomps=() present=() records=""
    local COMPS=() RELS=() KINDS=() SUMS=() OWNER_COMM="" OWNER_ARGV=() WAYBAR_STATE="" WSEV_STATE="" NMA_RUN="" NMA_ARGS=() IDLE_STATE="" IDLE_INHIBIT_STATE="" TA_STATE=""
    local DSP_STATE=""
    eval "$(grep -E '^(COMPS|RELS|KINDS|SUMS|OWNER_COMM|OWNER_ARGV|WAYBAR_STATE|WSEV_STATE|NMA_RUN|NMA_ARGS|IDLE_STATE|IDLE_INHIBIT_STATE|TA_STATE|DSP_STATE)=' "$b0/rollback.sh")"
    local comps=("${COMPS[@]}") rels=("${RELS[@]}") kinds=("${KINDS[@]}") sums=("${SUMS[@]}")
    for c in "${COMPONENTS[@]}" shared; do
        [[ " ${comps[*]} " == *" $c "* ]] || newcomps+=("$c")
        while IFS= read -r rel; do
            [[ " ${rels[*]} " == *" $rel "* ]] || new+=("$rel")
        done < <(comp_paths "$c")
    done
    [ ${#new[@]} -gt 0 ] || [ ${#newcomps[@]} -gt 0 ] || return 0
    umask 077
    STAGE="$b0/.extend"
    rm -rf -- "$STAGE"
    mkdir -- "$STAGE"
    cp -- "$b0/files.tar" "$STAGE/files.tar"
    for rel in "${new[@]}"; do
        s="$(current_sum "$rel")"
        rels+=("$rel") kinds+=("${s%% *}") sums+=("${s#* }")
        [ "${s%% *}" = absent ] || present+=("$rel")
        records+="$rel	${s%% *}	${s#* }"$'\n'
    done
    comps+=("${newcomps[@]}")
    # a baseline from before the nm-applet shim has no record of it: take it now, while the shim is not ours yet
    if [ -z "$NMA_RUN" ] && [[ " ${new[*]} " == *" .local/bin/nm-applet "* ]] \
        && [ "$(current_sum .local/bin/nm-applet | cut -d' ' -f1)" = absent ]; then
        record_nm_applet
    fi
    [ ${#present[@]} -eq 0 ] || tar -rf "$STAGE/files.tar" -C "$HOME_DIR" "${present[@]}"
    python3 - "$b0/manifest.json" "$STAGE/manifest.json" "$HOME_DIR" "$records" "${newcomps[@]}" <<'PY2'
import datetime, json, sys
src, out, home, records, newcomps = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:]
m = json.load(open(src))
m["components"] += newcomps
added = []
for line in records.splitlines():
    rel, kind, s = line.split("\t")
    e = {"path": f"{home}/{rel}", "kind": kind}
    if kind == "file":
        e["sha256"] = s
    elif kind == "symlink":
        e["symlink_target"] = s
    m["paths"].append(e)
    added.append(e["path"])
m.setdefault("extended", []).append({
    "utc": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "components": newcomps, "paths": added})
with open(out, "w") as fh:
    json.dump(m, fh, indent=2)
    fh.write("\n")
PY2
    write_rollback baseline-0 "$b0" > "$STAGE/rollback.sh"
    bash -n "$STAGE/rollback.sh"
    chmod 600 "$STAGE"/*
    mv -f -- "$STAGE/files.tar" "$b0/files.tar"
    mv -f -- "$STAGE/manifest.json" "$b0/manifest.json"
    mv -f -- "$STAGE/rollback.sh" "$b0/rollback.sh"
    rm -rf -- "$STAGE"
    STAGE=""
    umask 022
    log "baseline-0: now also covers ${newcomps[*]:+${newcomps[*]}: }${new[*]}"
}

# ---- apply ------------------------------------------------------------------
plain_file() { { [ -f "$1" ] && [ ! -L "$1" ]; } || die "$1 must exist as a regular file (not a symlink)"; }
link_or_absent() { [ -L "$1" ] || [ ! -e "$1" ] || die "$1 is a real file or directory, not a symlink; refusing to replace it"; }

plain_or_absent() { { [ ! -e "$1" ] && [ ! -L "$1" ]; } || { [ -f "$1" ] && [ ! -L "$1" ]; } || die "$1 must be a regular file (not a symlink) or absent"; }

# Nothing is ever written under ~/.themes or ~/.icons, whatever a symlink says. The
# destination's parent is resolved; its last component is the thing replaced, so
# a symlink that is itself being replaced (gtk-4.0) is not followed.
guard_dest() {
    local p t root
    p="$(realpath -m -- "$(dirname -- "$1")")/$(basename -- "$1")"
    for t in .themes .icons; do
        root="$(realpath -m -- "$HOME_DIR/$t")"
        case "$p/" in
            "$root"/* | "$HOME_DIR/$t"/*) die "refusing to write $1: it resolves into ~/$t ($p)" ;;
        esac
    done
}

# Paths that end up inside a CSS url("...") must need no escaping.
css_safe() { [[ "$1" =~ ^[A-Za-z0-9._/@+-]+$ ]] || die "$1 contains characters that need URL escaping; refusing"; }

theme_has() {   # the engine outputs this component links to
    local f
    for f in "$@"; do [ -s "$THEME_DIR/$f" ] || return 1; done
}
GTK_THEME_FILES=(gtk3.css gtk4.css kde.colors qt6ct.conf)
MARK_GTK3='seclegion-host:managed gtk3'
MARK_SETTINGS='seclegion-host:managed settings'

MARK_IDLE='seclegion-host:managed idle'

# idle touches nothing the owner has: our own units, our own symlink, our own state file
preflight_idle() {
    local f
    for f in "$CFG/systemd/user/$IDLE_INHIBIT_UNIT" "$CFG/systemd/user/$IDLE_UNIT"; do
        if [ -e "$f" ] || [ -L "$f" ]; then
            { [ -f "$f" ] && [ ! -L "$f" ] && grep -qF "$MARK_IDLE" "$f"; } \
                || die "$f exists and is not ours (no '$MARK_IDLE' marker); refusing to replace it"
        fi
    done
    link_or_absent "$HOME_DIR/.local/bin/seclegion-autolock"
    plain_or_absent "$CFG/seclegion/autolock"
}

# theme-auto touches only its own units and its own copy
preflight_theme_auto() {
