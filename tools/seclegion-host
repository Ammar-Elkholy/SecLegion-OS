preflight() {
    local comp="$1" f nd ns
    for f in luac python3 tar sha256sum; do command -v "$f" >/dev/null || die "$f is not installed"; done
    for f in "$(comp_source "$comp")" tools/seclegion-theme desktop/branding/seclegion-logo.png; do
        [ -e "$REPO/$f" ] || die "missing $f in the repo"
    done
    has_wayland || die "no Wayland session reachable; run apply inside the owner's session"
    case "$comp" in
        border)
            has_hyprland || die "Hyprland is not reachable (HYPRLAND_INSTANCE_SIGNATURE)"
            plain_file "$HYPR_MAIN"
            [ "$(count_lines '^require\("hyprland-border"\)$' "$HYPR_MAIN")" = 1 ] \
                || die "anchor require(\"hyprland-border\") must appear exactly once in $HYPR_MAIN"
            { [ ! -L "$CFG/hypr/seclegion-host.lua" ] && [ ! -d "$CFG/hypr/seclegion-host.lua" ]; } \
                || die "$CFG/hypr/seclegion-host.lua must be a regular file or absent"
            ;;
        notifications)
            plain_file "$HYPR_AUTO"
            nd="$(count_lines "$DUNST_RE" "$HYPR_AUTO")" ns="$(count_lines "$SWAYNC_RE" "$HYPR_AUTO")"
            [ $((nd + ns)) -ge 1 ] || die "no hl.exec_cmd(\"dunst\") or (\"swaync\") line in $HYPR_AUTO"
            link_or_absent "$CFG/swaync"
            ;;
        waybar)
            link_or_absent "$CFG/waybar"
            link_or_absent "$HOME_DIR/.local/bin/nm-applet"   # a real file here is the owner's: never clobber it
            ;;
        idle) preflight_idle ;;
        theme-auto) preflight_theme_auto ;;
        display) preflight_display ;;
        gtk|fm|settings) preflight_files "$comp" ;;
        lock)
            [ -L "$LOCK_CONF" ] || [ ! -e "$LOCK_CONF" ] || [ -f "$LOCK_CONF" ] \
                || die "$LOCK_CONF must be a regular file, a symlink or absent"
            ;;
        keys)
            # keys depends on border: the border's seclegion-host.lua is what loads seclegion-keys.lua
            has_hyprland || die "Hyprland is not reachable (HYPRLAND_INSTANCE_SIGNATURE)"
            [ -e "$REPO/tools/seclegion-keys-lint" ] || die "missing tools/seclegion-keys-lint in the repo"
            plain_file "$HYPR_KEYS"
            { [ -f "$CFG/hypr/seclegion-host.lua" ] && grep -qE "$KEYS_REQ_RE" "$CFG/hypr/seclegion-host.lua" \
                && grep -qx 'require("seclegion-host")' "$HYPR_MAIN"; } \
                || die "keys needs the border component: $CFG/hypr/seclegion-host.lua with its pcall(require, \"seclegion-keys\") line, loaded from $HYPR_MAIN. Apply border first: $PROG apply border"
            link_or_absent "$KEYS_LINK"
            ;;
        osd)
            # a real file here (a hand-made wrapper, or the binary itself) is the owner's: never clobber it
            for f in "${OSD_BINS[@]}"; do link_or_absent "$HOME_DIR/.local/bin/$f"; done
            ;;
    esac
}

# The keys must not take an owner key: lint against the owner's keybinds.lua
# and, when Hyprland answers, the live binds (read-only `hyprctl binds -j`).
keys_check() {
    local args=() out
    if hyprctl binds -j > "$BK/binds.json" 2>/dev/null; then
        chmod 600 "$BK/binds.json"
        args=(--binds-json "$BK/binds.json")
    else
        rm -f -- "$BK/binds.json"
        log "keys: hyprctl binds -j failed; checking against $HYPR_KEYS only"
    fi
    out="$(python3 "$REPO/tools/seclegion-keys-lint" "$HYPR_KEYS" "$1" "${args[@]}" 2>&1)" \
        || die "seclegion-keys-lint refused the keys: $out"
    log "keys: $(tail -n1 <<< "$out")"
}

# Static checks of the lock screen config; hyprlock itself is never run (it would lock the screen).
#   keys:   every section and key is one hyprlock 0.9.x knows, input-field has font_color
#   source: the one `source` file exists and defines every $sl_ variable the config uses
lock_check() {
    python3 - "$1" "$2" "$HOME_DIR" <<'PY'
import os, re, sys
conf, mode, home = sys.argv[1:4]
KEYS = {
    "background": "monitor path color blur_size blur_passes noise contrast brightness vibrancy vibrancy_darkness reload_time reload_cmd crossfade_time zindex",
    "label": "monitor text color font_size font_family position halign valign rotate shadow_passes shadow_size shadow_color shadow_boost text_align zindex",
    "input-field": "monitor size outline_thickness rounding dots_size dots_spacing dots_center dots_rounding dots_text_format fade_on_empty fade_timeout font_color font_family font_size inner_color outer_color check_color fail_color fail_text capslock_color numlock_color bothlock_color invert_numlock swap_font_color hide_input hide_input_base_color placeholder_text position halign valign zindex",
}
problems, section, sources, used, seen = [], None, [], set(), {}
for n, raw in enumerate(open(conf), 1):
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if line.endswith("{"):
        section = line[:-1].strip()
        seen[section] = set()
        if section not in KEYS:
            problems.append(f"line {n}: unknown section {section!r}")
    elif line == "}":
        section = None
    elif "=" in line:
        key, val = (x.strip() for x in line.split("=", 1))
        if section is None and key == "source":
            sources.append(val)
        elif section is None:
            problems.append(f"line {n}: key {key!r} outside a section")
        elif section in KEYS:
            seen[section].add(key)
            if key not in KEYS[section].split():
                problems.append(f"line {n}: {key!r} is not a hyprlock {section} key (hyprlock ignores it silently)")
        used.update(re.findall(r"\$(sl_[a-z0-9_]+)", val))
if "font_color" not in seen.get("input-field", ()):
    problems.append("input-field has no font_color: the dots would draw in hyprlock's dark default")
if len(sources) != 1:
    problems.append(f"want exactly one source line, found {len(sources)}")
elif mode == "source":
    path = re.sub(r"^~(?=/)", home, sources[0])
    if not os.path.isfile(path):
        problems.append(f"sourced file {path} does not exist")
    else:
        defined = set(re.findall(r"^\$(sl_[a-z0-9_]+)\s*=", open(path).read(), re.M))
        problems += [f"${v} is not defined in {path}" for v in sorted(used - defined)]
if problems:
    sys.exit("lock config: " + "; ".join(problems))
PY
}

