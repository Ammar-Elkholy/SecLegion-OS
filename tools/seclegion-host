install_fm() {
    local d="$INST/fm" f sec kv x="$CFG/xfce4/xfconf/xfce-perchannel-xml/thunar.xml" yz="$CFG/yazi"
    # default file manager: one key, one section
    ini_set "$CFG/mimeapps.list" "Default Applications" inode/directory=thunar.desktop
    # Thunar status bar (free space)
    if [ ! -e "$x" ]; then
        install -D -m 644 -- "$d/thunar.xml" "$x"
    else
        python3 - "$x" <<'PY'
import re, sys
p = sys.argv[1]
t = open(p, encoding="utf-8").read()
prop = '<property name="last-statusbar-visible" type="bool" value="true"/>'
pat = re.compile(r'<property\s+name="last-statusbar-visible"[^>]*/>')
if pat.search(t):
    new = pat.sub(prop, t, 1)
else:
    m = re.search(r"^([ \t]*)<property\b", t, re.M)
    indent = m.group(1) if m else "  "
    i = t.rindex("</channel>")
    head = t[:i]
    ws = head[len(head.rstrip(" \t")):]
    head = head.rstrip(" \t")
    if not head.endswith("\n"):
        head += "\n"
    new = head + indent + prop + "\n" + ws + t[i:]
if new != t:
    open(p, "w", encoding="utf-8").write(new)
PY
        python3 -c 'import sys, xml.etree.ElementTree as E; E.parse(sys.argv[1])' "$x"
    fi
    log "thunar: last-statusbar-visible=true; a running Thunar or xfconfd may overwrite $x when it exits"
    # Dolphin: only the keys in the fragment
    while IFS=$'\t' read -r sec kv; do ini_set "$CFG/dolphinrc" "$sec" "$kv"; done < <(ini_pairs "$d/dolphinrc.part")
    # yazi: the plugin file, and the enable line in init.lua once
    install -D -m 644 -- "$d/yazi/plugins/seclegion-space.yazi/main.lua" "$yz/plugins/seclegion-space.yazi/main.lua"
    if ! grep -qF 'require("seclegion-space")' "$yz/init.lua" 2>/dev/null; then
        [ -f "$yz/init.lua" ] && [ -n "$(tail -c1 "$yz/init.lua")" ] && printf '\n' >> "$yz/init.lua"
        { printf -- '-- seclegion-host: free space in the status bar (delete these two lines to disable)\n'
          grep -v '^[[:space:]]*--' "$d/yazi/init.lua.part"; } >> "$yz/init.lua"
    fi
    luac -p "$yz/init.lua"
    log "fm: Thunar is the inode/directory default; open apps keep their old state until restarted"
}

# A usable theme is the engine's own layout: theme/current is a symlink to
# theme/<hash>/ holding every contract file. The host tool never writes into
# current/ itself; it asks the engine (seclegion-theme reset --no-hooks).
theme_ok() {
    local f
    [ -L "$THEME_DIR" ] || return 1
    for f in hyprlock-colors.conf colors.css colors.json; do [ -s "$THEME_DIR/$f" ] || return 1; done
}

# Make theme/current a valid engine symlink, whatever is there now. A real
# directory left by the old copy-based seeding is moved into the backup (never
# deleted). What was there, and what the engine created, is recorded in
# <backup>/theme-undo and manifest.json so the rollback restores it exactly.
ensure_theme() {
    local root="$STATE/theme" undo="$BK/theme-undo" legacy=theme-current-legacy pre names n out
    theme_ok && return 0
    pre="$(ls -A -- "$root" 2>/dev/null || true)"
    {
        if [ -L "$THEME_DIR" ]; then printf 'before=symlink\ntarget=%s\n' "$(readlink -- "$THEME_DIR")"
        elif [ -e "$THEME_DIR" ]; then printf 'before=moved\nlegacy=%s\n' "$legacy"
        else printf 'before=absent\n'; fi
        if [ ! -d "$root" ]; then printf 'root_created=1\n'; fi
    } > "$undo"
    chmod 600 "$undo"
    if [ ! -L "$THEME_DIR" ] && [ -e "$THEME_DIR" ]; then
        mv -T -- "$THEME_DIR" "$BK/$legacy"
        log "theme: moved the old $THEME_DIR into the backup"
    fi
    out="$(XDG_STATE_HOME="$HOME_DIR/.local/state" HOME="$HOME_DIR" "$REPO/tools/seclegion-theme" reset --no-hooks 2>&1)" \
        || { n=$?; out="seclegion-theme reset failed (rc $n): $out"; }
    names="$(ls -A -- "$root" 2>/dev/null || true)"
    while IFS= read -r n; do
        if [[ "$n" =~ ^[0-9a-f]{16}$ ]] && ! grep -qxF -- "$n" <<< "$pre"; then printf 'created=%s\n' "$n" >> "$undo"; fi
    done <<< "$names"
    python3 - "$BK/manifest.json" "$undo" <<'PY'
import json, sys
mf, undo = sys.argv[1:3]
t = {"created": []}
for line in open(undo):
    k, _, v = line.rstrip("\n").partition("=")
    if k == "created":
        t["created"].append(v)
    else:
        t[k] = v
m = json.load(open(mf))
m["theme"] = t
with open(mf, "w") as fh:
    json.dump(m, fh, indent=2)
    fh.write("\n")
PY
    case "$out" in "seclegion-theme reset failed"*) die "$out" ;; esac
    theme_ok || die "$THEME_DIR is not a symlink to a complete theme (hyprlock-colors.conf, colors.css, colors.json) after seclegion-theme reset"
    log "theme: seclegion-theme reset --no-hooks wrote $(readlink -- "$THEME_DIR")"
}

# The settings component is assembled from four places: the two Python packages,
# the launchers, and (under .sl-home, moved out at install time) the two wrappers
# and the desktop entry. The wrappers bake the installed python/ directory.
stage_settings() {
    local py="$INST/settings/python" f w
    css_safe "$py"
    mkdir -p -- "$STAGE/python" "$STAGE/.sl-home/bin" "$STAGE/.sl-home/sh" "$STAGE/.sl-home/applications"
    cp -r -- "$REPO/desktop/settings/seclegion_settings" "$REPO/desktop/theme/seclegion_theme" "$REPO/desktop/theme/tokens.toml" "$STAGE/python/"
    find "$STAGE/python" -name __pycache__ -type d -prune -exec rm -rf -- {} +
    for f in seclegion-set seclegion-settings seclegion-root-apply seclegion-theme; do cp -- "$REPO/tools/$f" "$STAGE/$f"; done
    for w in "seclegion-set:seclegion_settings.backend.cli" "seclegion-settings:seclegion_settings.ui.app" "seclegion-theme:seclegion_theme.cli"; do
        # REUSE-IgnoreStart
        printf '#!/usr/bin/python3 -I\n# SPDX-License-Identifier: MIT\n# %s: written by seclegion-host apply settings; rollback removes it.\nimport sys\n\nsys.path.insert(0, "%s")\n\nfrom %s import main  # noqa: E402\n\nsys.exit(main())\n' \
            "$MARK_SETTINGS" "$py" "${w#*:}" > "$STAGE/.sl-home/bin/${w%%:*}"
        # REUSE-IgnoreEnd
    done
    # the picker is a bash script: our marker goes in after its shebang and SPDX line
    sed "3a # $MARK_SETTINGS: written by seclegion-host apply settings; rollback removes it." \
        "$REPO/tools/seclegion-theme-pick" > "$STAGE/.sl-home/sh/seclegion-theme-pick"
    # the doctor is stdlib Python with no imports of ours: a marked copy (marker after shebang and SPDX line)
    sed "3a # $MARK_SETTINGS: written by seclegion-host apply settings; rollback removes it." \
        "$REPO/tools/seclegion-doctor" > "$STAGE/.sl-home/sh/seclegion-doctor"
    # REUSE-IgnoreStart
    { printf '# SPDX-License-Identifier: MIT\n# %s: written by seclegion-host apply settings; rollback removes it.\n' "$MARK_SETTINGS"
      grep -v '^# SPDX-' "$REPO/desktop/settings/seclegion-settings.desktop" \
          | sed "s|^Exec=.*|Exec=$HOME_DIR/.local/bin/seclegion-settings|"; } > "$STAGE/.sl-home/applications/seclegion-settings.desktop"
    # REUSE-IgnoreEnd
}

stage() {   # copy the repo component and validate it, outside any live path
    local comp="$1" esc f
    STAGE="$INST/.stage-$comp"
    rm -rf -- "$STAGE"
    mkdir -p -- "$STAGE"
    if [ "$comp" = gtk ]; then
        :   # nothing is copied: the files are generated into place from the live theme
    elif [ "$comp" = settings ]; then
        stage_settings
    elif [ "$comp" = border ] || [ "$comp" = lock ] || [ "$comp" = keys ]; then
        cp -- "$REPO/$(comp_source "$comp")" "$STAGE/"
    else
        cp -r -- "$REPO/$(comp_source "$comp")/." "$STAGE/"
    fi
    # NTFS modes mean nothing; installed copies are plain 755/644
    find "$STAGE" -type d -exec chmod 755 {} +
    find "$STAGE" -type f -exec chmod 644 {} +
    esc="$(printf '%s' "$HOME_DIR" | sed 's/[&|\\]/\\&/g')"
    find "$STAGE" -type f \( -name '*.css' -o -name '*.json' -o -name '*.jsonc' -o -name '*.lua' \) \
        -exec sed -i "s|__HOME__|$esc|g" {} +
    if [ "$comp" = waybar ]; then
        # helpers and the user unit are not waybar config: they go to host/bin and ~/.config/systemd/user
        mkdir -p -- "$STAGE/.sl-bin"
        mv -- "$STAGE/seclegion-ws" "$STAGE/seclegion-wsevents" "$STAGE/$WSEV_UNIT" "$STAGE/nm-applet" "$STAGE/.sl-bin/"
        # short-lived bar modules (custom/sl-*): the config runs them from host/bin
        for f in seclegion-vpn seclegion-sec seclegion-gpu seclegion-uptime seclegion-dnd seclegion-ai seclegion-sysmon seclegion-wifi; do
            mv -- "$STAGE/$f" "$STAGE/.sl-bin/"
            chmod 755 "$STAGE/.sl-bin/$f"
            case "$(head -n1 -- "$STAGE/.sl-bin/$f")" in  # syntax-check each module in its own language
                *python3*) python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$STAGE/.sl-bin/$f" ;;
                *) bash -n "$STAGE/.sl-bin/$f" ;;
            esac
        done
        # the System Monitor's and the Wi-Fi panel's python trees ride along when the repo has them
        # (not in --system's virtual repo)
        for f in sysmon/seclegion_sysmon wifi/seclegion_wifi; do
            [ -d "$REPO/desktop/$f" ] || continue
            mkdir -p -- "$STAGE/.sl-bin/python"
            cp -r -- "$REPO/desktop/$f" "$STAGE/.sl-bin/python/"
        done
        if [ -d "$STAGE/.sl-bin/python" ]; then
            find "$STAGE/.sl-bin/python" -name __pycache__ -prune -exec rm -rf {} +
            find "$STAGE/.sl-bin/python" -type d -exec chmod 755 {} +
            find "$STAGE/.sl-bin/python" -type f -exec chmod 644 {} +
        fi
        rm -f -- "$STAGE"/*.in
        chmod 755 "$STAGE/.sl-bin/seclegion-ws" "$STAGE/.sl-bin/seclegion-wsevents" "$STAGE/.sl-bin/nm-applet"
        bash -n "$STAGE/.sl-bin/nm-applet"
        python3 -c 'import ast, sys; [ast.parse(open(f).read(), f) for f in sys.argv[1:]]' \
            "$STAGE/.sl-bin/seclegion-ws" "$STAGE/.sl-bin/seclegion-wsevents"
    fi
    if [ "$comp" = idle ]; then
        mkdir -p -- "$STAGE/.sl-units"
        mv -- "$STAGE/$IDLE_INHIBIT_UNIT" "$STAGE/$IDLE_UNIT" "$STAGE/.sl-units/"
        chmod 755 "$STAGE/seclegion-autolock"
        bash -n "$STAGE/seclegion-autolock"
        grep -q '^ExecStart=/usr/bin/systemd-inhibit --what=idle ' "$STAGE/.sl-units/$IDLE_INHIBIT_UNIT" \
            || die "$IDLE_INHIBIT_UNIT has no idle inhibitor ExecStart"
        grep -q '^ExecStart=.* -c %h/.local/share/seclegion/host/idle/hypridle.conf$' "$STAGE/.sl-units/$IDLE_UNIT" \
            || die "$IDLE_UNIT does not run hypridle on the installed conf"
        grep -q '@TIMEOUT@' "$STAGE/hypridle.conf.in" || die "hypridle.conf.in has no @TIMEOUT@"
    fi
    if [ "$comp" = theme-auto ]; then
        mkdir -p -- "$STAGE/.sl-units" "$STAGE/python"
        mv -- "$STAGE/$TA_PATH_UNIT" "$STAGE/$TA_UNIT" "$STAGE/.sl-units/"
        cp -r -- "$REPO/desktop/theme/seclegion_theme" "$REPO/desktop/theme/tokens.toml" "$STAGE/python/"
        find "$STAGE/python" -name __pycache__ -type d -prune -exec rm -rf -- {} +
        cp -- "$REPO/tools/seclegion-theme" "$STAGE/seclegion-theme"
        chmod 755 "$STAGE/seclegion-theme"
        find "$STAGE/python" -type d -exec chmod 755 {} +
        find "$STAGE/python" -type f -exec chmod 644 {} +
        python3 -c 'import ast, sys; [ast.parse(open(f).read(), f) for f in sys.argv[1:]]' "$STAGE/seclegion-theme"
        grep -q '^PathChanged=%h/.cache/current_wallpaper$' "$STAGE/.sl-units/$TA_PATH_UNIT" \
            || die "$TA_PATH_UNIT does not watch current_wallpaper"
        grep -q '^ExecStart=.* %h/.local/share/seclegion/host/theme-auto/seclegion-theme sync$' "$STAGE/.sl-units/$TA_UNIT" \
            || die "$TA_UNIT does not run the installed seclegion-theme sync"
    fi
    if [ "$comp" = display ]; then
        mkdir -p -- "$STAGE/.sl-units"
        mv -- "$STAGE/$DSP_UNIT" "$STAGE/.sl-units/"
        chmod 755 "$STAGE/seclegion-displayd" "$STAGE/seclegion-wallpaper" "$STAGE/seclegion-display-menu"
        python3 -c 'import ast, sys; [ast.parse(open(f).read(), f) for f in sys.argv[1:]]' \
            "$STAGE/seclegion-displayd" "$STAGE/seclegion-wallpaper" "$STAGE/seclegion-display-menu"
        grep -qF "$MARK_DISPLAY" "$STAGE/.sl-units/$DSP_UNIT" || die "$DSP_UNIT lacks the '$MARK_DISPLAY' marker"
        grep -qx 'ExecStart=%h/.local/share/seclegion/host/display/seclegion-displayd' "$STAGE/.sl-units/$DSP_UNIT" \
            || die "$DSP_UNIT does not run the installed seclegion-displayd"
    fi
    case "$comp" in
        settings)
            # the launchers and wrappers are executables; the root helper is 0755 and nothing else is writable by others
            chmod 755 "$STAGE/seclegion-set" "$STAGE/seclegion-settings" "$STAGE/seclegion-root-apply" "$STAGE/seclegion-theme" \
                "$STAGE/.sl-home/bin/seclegion-set" "$STAGE/.sl-home/bin/seclegion-settings" "$STAGE/.sl-home/bin/seclegion-theme" \
                "$STAGE/.sl-home/sh/seclegion-theme-pick"
            bash -n "$STAGE/.sl-home/sh/seclegion-theme-pick"
            grep -qF "$MARK_SETTINGS" "$STAGE/.sl-home/sh/seclegion-theme-pick" || die "the picker lacks our marker"
            python3 -c 'import ast, sys; [ast.parse(open(f).read(), f) for f in sys.argv[1:]]' \
                "$STAGE"/seclegion-* "$STAGE"/.sl-home/bin/*
            grep -q '^Exec=/' "$STAGE/.sl-home/applications/seclegion-settings.desktop" || die "desktop entry has no Exec line"
            grep -qx 'Categories=Settings;System;' "$STAGE/.sl-home/applications/seclegion-settings.desktop" \
                || die "desktop entry lacks Categories=Settings;System;"
            ;;
        border) luac -p "$STAGE/seclegion-host.lua" ;;
        keys)
            luac -p "$STAGE/seclegion-keys.lua"
            keys_check "$STAGE/seclegion-keys.lua"
            ;;
        lock) lock_check "$STAGE/hyprlock.conf" keys ;;
        osd)
            for f in "${OSD_BINS[@]}"; do
                chmod 755 "$STAGE/$f"   # run through the ~/.local/bin symlinks
                bash -n "$STAGE/$f"
            done
            ;;
        notifications) python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$STAGE/config.json" ;;
        fm)
            luac -p "$STAGE/yazi/plugins/seclegion-space.yazi/main.lua"
            python3 -c 'import sys, xml.etree.ElementTree as E; E.parse(sys.argv[1])' "$STAGE/thunar.xml"
            grep -qF 'require("seclegion-space")' "$STAGE/yazi/init.lua.part" || die "init.lua.part has no seclegion-space line"
            [ -n "$(ini_pairs "$STAGE/dolphinrc.part")" ] || die "dolphinrc.part has no key"
            ;;
        waybar)
            python3 - "$STAGE/config.jsonc" <<'PY'
import json, sys
json.loads("\n".join(l for l in open(sys.argv[1]) if not l.lstrip().startswith("//")))
PY
            ;;
    esac
}

# The one autostart edit, idempotent: keep the first swaync exec line and drop
# every other swaync and dunst line; with no swaync line, the first dunst line
# becomes swaync. Collapses the duplicate swaync lines the old tool left behind.
autostart_swaync() {
    local tmp="$BK/autostart.lua.new"
    S="$SWAYNC_RE" D="$DUNST_RE" HAVE="$(count_lines "$SWAYNC_RE" "$HYPR_AUTO")" awk '
        $0 ~ ENVIRON["S"] { if (seen++) next; print; next }
        $0 ~ ENVIRON["D"] {
            if (ENVIRON["HAVE"] > 0 || seen++) next
            sub(/hl\.exec_cmd\("dunst"\)/, "hl.exec_cmd(\"swaync\")"); print; next
        }
        { print }' "$HYPR_AUTO" > "$tmp"
    if ! cmp -s -- "$tmp" "$HYPR_AUTO"; then
        cat -- "$tmp" > "$HYPR_AUTO"   # in place: keeps the file's inode and mode
        log "autostart: one hl.exec_cmd(\"swaync\") line, no dunst"
    fi
    rm -f -- "$tmp"
}

install_comp() {
    local comp="$1" f
    case "$comp" in fm | settings | idle | theme-auto | display) ;; *) ensure_theme ;; esac   # these read no theme file
    rm -rf -- "${INST:?}/$comp"
    if [ "$comp" = gtk ]; then rm -rf -- "$STAGE"; else mv -T -- "$STAGE" "$INST/$comp"; fi
    STAGE=""
    case "$comp" in
        border)
            install -m 644 -- "$INST/border/seclegion-host.lua" "$CFG/hypr/seclegion-host.lua"
            grep -qx 'require("seclegion-host")' "$HYPR_MAIN" \
                || sed -i '/^require("hyprland-border")$/a require("seclegion-host")' "$HYPR_MAIN"
            luac -p "$HYPR_MAIN" "$CFG/hypr/seclegion-host.lua"
            ;;
        notifications)
            ln -sfn -- "$INST/notifications" "$CFG/swaync"
            if [ -z "$SL_SYSTEM_BACKUP" ]; then   # --system: the skel hyprland.lua starts swaync itself
                autostart_swaync
                { [ "$(count_lines "$SWAYNC_RE" "$HYPR_AUTO")" = 1 ] && [ "$(count_lines "$DUNST_RE" "$HYPR_AUTO")" = 0 ]; } \
                    || die "autostart edit did not leave exactly one swaync and no dunst exec line"
                luac -p "$HYPR_AUTO"
            fi
            ;;
        waybar)
            rm -rf -- "${INST:?}/bin"
            mv -T -- "$INST/waybar/.sl-bin" "$INST/bin"
            install -D -m 644 -- "$INST/bin/$WSEV_UNIT" "$CFG/systemd/user/$WSEV_UNIT"
            rm -f -- "$INST/bin/$WSEV_UNIT"
            mkdir -p -- "$HOME_DIR/.local/bin"
            ln -sfn -- "$INST/bin/nm-applet" "$HOME_DIR/.local/bin/nm-applet"
            ln -sfn -- "$INST/waybar" "$CFG/waybar"
            ;;
        gtk) install_gtk ;;
        fm) install_fm ;;
        settings) install_settings ;;
        idle) install_idle ;;
        theme-auto) install_theme_auto ;;
        display) install_display ;;
        lock)
            lock_check "$INST/lock/hyprlock.conf" source
            ln -sfn -- "$INST/lock/hyprlock.conf" "$LOCK_CONF"
            ;;
        keys) ln -sfn -- "$INST/keys/seclegion-keys.lua" "$KEYS_LINK" ;;
        osd)
            mkdir -p -- "$HOME_DIR/.local/bin"
            for f in "${OSD_BINS[@]}"; do ln -sfn -- "$INST/osd/$f" "$HOME_DIR/.local/bin/$f"; done
            ;;
    esac
    if ! cmp -s -- "$REPO/desktop/branding/seclegion-logo.png" "$SHARE/seclegion-logo.png"; then
        install -m 644 -- "$REPO/desktop/branding/seclegion-logo.png" "$SHARE/seclegion-logo.png"
    fi
    log "installed $comp"
}

# Stop the running nm-applet by pid and start it again through the shim (the same arguments;
# the shim drops --indicator). Not running: nothing to do, the shim applies at its next start.
restart_nm_applet() {
    local p pid
    pid="$(pids_of nm-applet | head -n1)"
    [ -n "$pid" ] || { log "nm-applet is not running; the shim applies at its next start"; return 0; }
    mapfile -t NMA_ARGS < <(proc_argv "$pid" | tail -n +2)
    for p in $(pids_of nm-applet); do stop_pid "$p"; done
    start_argv "$HOME_DIR/.local/bin/nm-applet" ${NMA_ARGS[@]+"${NMA_ARGS[@]}"}
    NMA_RESTARTED=1
}

reload_comp() {
    local p
    case "$1" in
        border | keys) hyprctl reload >/dev/null ;;
        notifications)
            for p in $(owner_pid) $(pids_of dunst) $(pids_of swaync); do stop_pid "$p"; done
            start_argv swaync
            ;;
        waybar)
            systemctl --user daemon-reload
            systemctl --user enable --now "$WSEV_UNIT"
            systemctl --user try-restart "$WSEV_UNIT"   # pick up a changed helper
            systemctl --user restart waybar
            restart_nm_applet
            ;;
        gtk | fm | settings) ;;   # no daemon: apps read these files on their next start
        idle)
            # new unit files; then re-apply the state in force (a fresh host: default, which
            # stops nothing that runs), so a changed conf or unit takes effect
            systemctl --user daemon-reload
            "$HOME_DIR/.local/bin/seclegion-autolock" set "$("$HOME_DIR/.local/bin/seclegion-autolock" status 2>/dev/null)" >/dev/null
            ;;
        theme-auto)
            systemctl --user daemon-reload
            systemctl --user enable --now "$TA_PATH_UNIT"
            ;;
        display)
            # restart: a re-apply must run the new copy of the daemon
            systemctl --user daemon-reload
            systemctl --user enable "$DSP_UNIT"
            systemctl --user restart "$DSP_UNIT"
            ;;
        lock) ;;   # read by hyprlock at lock time: nothing to reload, and never lock the screen to test
        osd) ;;    # plain symlinks, read at each exec: nothing to reload
    esac
}

arm_deadman() {
    systemd-run --user --quiet --unit="$DEADMAN" --on-active=120 --timer-property=AccuracySec=1s \
        --collect "$BASH" "$BK/rollback.sh"
    printf '%s\n' "$1" > "$PENDING"
    log "dead-man armed: automatic rollback in 120 s unless '$PROG confirm'"
}

verify_gtk() {
    local f g4="$CFG/gtk-4.0" cur="$THEME_DIR" want
    [ -f "$CFG/gtk-3.0/gtk.css" ] && grep -qF "$MARK_GTK3" "$CFG/gtk-3.0/gtk.css" \
        && grep -qxF "@import url(\"file://$cur/gtk3.css\");" "$CFG/gtk-3.0/gtk.css" || die "gtk-3.0/gtk.css is not ours or lacks the import"
    [ -d "$g4" ] && [ ! -L "$g4" ] && [ -f "$g4/.seclegion-managed" ] || die "$g4 is not the managed directory"
    grep -qxF "@import url(\"file://$cur/gtk4.css\");" "$g4/gtk.css" || die "gtk-4.0/gtk.css lacks the SecLegion import"
    for f in gtk3.css gtk4.css; do [ -s "$cur/$f" ] || die "$cur/$f is missing"; done
    for f in "$HOME_DIR/.local/share/color-schemes/SecLegion.colors:kde.colors" "$CFG/qt6ct/colors/SecLegion.conf:qt6ct.conf"; do
        want="${f#*:}" f="${f%:*}"
        [ -L "$f" ] && [ "$(readlink -f -- "$f")" = "$(readlink -f -- "$cur/$want")" ] && [ -s "$f" ] || die "$f does not resolve to $want"
    done
    grep -qx 'ColorScheme=SecLegion' "$CFG/kdeglobals" || die "kdeglobals has no ColorScheme=SecLegion"
    log "gtk-ok"
}

verify_fm() {
    local yz="$CFG/yazi"
    grep -qx 'inode/directory=thunar.desktop' "$CFG/mimeapps.list" || die "mimeapps.list has no inode/directory=thunar.desktop"
    grep -q 'name="last-statusbar-visible" type="bool" value="true"' "$CFG/xfce4/xfconf/xfce-perchannel-xml/thunar.xml" \
        || die "thunar.xml has no last-statusbar-visible=true"
    grep -qx 'ShowStatusBar=FullWidth' "$CFG/dolphinrc" || die "dolphinrc has no ShowStatusBar=FullWidth"
    cmp -s -- "$INST/fm/yazi/plugins/seclegion-space.yazi/main.lua" "$yz/plugins/seclegion-space.yazi/main.lua" || die "yazi plugin differs from the repo copy"
    [ "$(count_lines 'require\("seclegion-space"\)' "$yz/init.lua")" = 1 ] || die "yazi init.lua must enable the plugin exactly once"
    log "fm-ok"
}

verify_settings() {
    local d="$INST/settings" f
    for f in seclegion-set seclegion-settings seclegion-root-apply seclegion-theme; do
        [ -x "$d/$f" ] || die "$d/$f is missing or not executable"
    done
    [ "$(stat -c %a -- "$d/seclegion-root-apply")" = 755 ] || die "$d/seclegion-root-apply is not mode 0755"
    for f in seclegion_settings seclegion_theme; do [ -d "$d/python/$f" ] || die "$d/python/$f is missing"; done
    for f in seclegion-settings seclegion-set seclegion-theme seclegion-theme-pick; do
        [ -x "$HOME_DIR/.local/bin/$f" ] && grep -qF "$MARK_SETTINGS" "$HOME_DIR/.local/bin/$f" || die "$HOME_DIR/.local/bin/$f is missing or not ours"
    done
    grep -qx 'Categories=Settings;System;' "$HOME_DIR/.local/share/applications/seclegion-settings.desktop" \
        || die "seclegion-settings.desktop is missing or lacks its Categories"
    # -B: running the installed copy must not leave __pycache__ behind
    python3 -I -B "$HOME_DIR/.local/bin/seclegion-set" --help >/dev/null || die "the installed seclegion-set wrapper does not run"
    python3 -I -B "$d/seclegion-theme" --help >/dev/null || die "the installed seclegion-theme launcher does not run"
    python3 -I -B "$HOME_DIR/.local/bin/seclegion-theme" --help >/dev/null || die "the installed seclegion-theme wrapper does not run"
    log "settings-ok"
}

verify_idle() {
    local d="$INST/idle" f v conf="$INST/idle/hypridle.conf" want
    for f in "$CFG/systemd/user/$IDLE_INHIBIT_UNIT" "$CFG/systemd/user/$IDLE_UNIT"; do
        [ -f "$f" ] && grep -qF "$MARK_IDLE" "$f" || die "$f is missing or not ours"
    done
    [ -x "$d/seclegion-autolock" ] && [ -f "$d/hypridle.conf.in" ] || die "$d lacks seclegion-autolock or hypridle.conf.in"
    [ -L "$HOME_DIR/.local/bin/seclegion-autolock" ] \
        && [ "$(readlink -f -- "$HOME_DIR/.local/bin/seclegion-autolock")" = "$(readlink -f -- "$d/seclegion-autolock")" ] \
        || die "$HOME_DIR/.local/bin/seclegion-autolock does not resolve to the installed copy"
    v="$("$HOME_DIR/.local/bin/seclegion-autolock" status 2>/dev/null)" || die "seclegion-autolock status failed"
    # the units must match the state: default none, never the inhibitor, a delay both
    case "$v" in
        default) unit_active "$IDLE_INHIBIT_UNIT" && die "autolock is default but $IDLE_INHIBIT_UNIT is running"
                 unit_active "$IDLE_UNIT" && die "autolock is default but $IDLE_UNIT is running" ;;
        never) unit_active "$IDLE_INHIBIT_UNIT" || die "autolock is never but $IDLE_INHIBIT_UNIT is not running" ;;
        15m | 30m | 60m)
            unit_active "$IDLE_INHIBIT_UNIT" && unit_active "$IDLE_UNIT" || die "autolock is $v but its units are not both running"
            case "$v" in 15m) want=900 ;; 30m) want=1800 ;; *) want=3600 ;; esac
            grep -qx "    timeout = $want" "$conf" || die "$conf has no timeout = $want" ;;
        *) die "seclegion-autolock status printed '$v'" ;;
    esac
    log "idle-ok ($v)"
}

verify_theme_auto() {
    local d="$INST/theme-auto" f
    for f in "$CFG/systemd/user/$TA_PATH_UNIT" "$CFG/systemd/user/$TA_UNIT"; do
        [ -f "$f" ] && grep -qF 'seclegion-host:managed theme-auto' "$f" || die "$f is missing or not ours"
    done
    [ -L "$CFG/systemd/user/default.target.wants/$TA_PATH_UNIT" ] || die "$TA_PATH_UNIT is not enabled"
    unit_active "$TA_PATH_UNIT" || die "$TA_PATH_UNIT is not active"
    python3 -I -B "$d/seclegion-theme" --help >/dev/null || die "the installed seclegion-theme launcher does not run"
    log "theme-auto-ok (auto theme stays as it was; turn it on with: seclegion-theme auto on)"
}

verify_display() {
    local f="$CFG/systemd/user/$DSP_UNIT" s
    [ -f "$f" ] && grep -qF "$MARK_DISPLAY" "$f" || die "$f is missing or not ours"
    [ -L "$CFG/systemd/user/default.target.wants/$DSP_UNIT" ] || die "$DSP_UNIT is not enabled"
    [ -x "$INST/display/seclegion-displayd" ] || die "$INST/display/seclegion-displayd is not executable"
    [ -x "$HOME_DIR/.local/bin/seclegion-display-menu" ] || die "~/.local/bin/seclegion-display-menu is missing"
    # the daemon exits at once without HYPRLAND_INSTANCE_SIGNATURE in the user manager: give it a
    # second, then require active (not activating: that is the restart loop)
    sleep 1
    s="$(systemctl --user is-active "$DSP_UNIT" 2>/dev/null)" || true
    [ "$s" = active ] || die "$DSP_UNIT is $s, not active (journalctl --user -u $DSP_UNIT)"
    log "display-ok"
}

verify_comp() {
    local e i
    case "$1" in
        border)
            e="$(hyprctl configerrors 2>&1)" || true
            [ -z "${e//[[:space:]]/}" ] || die "hyprctl configerrors: $e"
            ;;
        keys)
            e="$(hyprctl configerrors 2>&1)" || true
            [ -z "${e//[[:space:]]/}" ] || die "hyprctl configerrors: $e"
            [ "$(readlink -f -- "$KEYS_LINK")" = "$(readlink -f -- "$INST/keys/seclegion-keys.lua")" ] \
                || die "$KEYS_LINK does not resolve to the installed keys"
            # the pcall in seclegion-host.lua hides a runtime error (configerrors stays
            # empty), so every hl.bind of the file (indented ones inside a submap too) must
            # be live, by its description
            e="$(grep -c '^[[:space:]]*hl\.bind(' "$INST/keys/seclegion-keys.lua")" || true
            i="$(hyprctl binds -j | python3 -c 'import json, sys; print(sum(str(b.get("description", "")).startswith("seclegion-keys:") for b in json.load(sys.stdin)))')"
            [ "$i" = "$e" ] || die "$i of the $e seclegion-keys binds are live: seclegion-keys.lua did not load (see the Hyprland log)"
            log "keys: $i binds live"
            ;;
        notifications)
            wait_owner swaync || die "swaync did not become the org.freedesktop.Notifications owner"
            [ -z "$(pids_of dunst)" ] || die "dunst is still running"
            ;;
        waybar)
            for i in $(seq 1 30); do unit_active waybar && break; sleep 0.1; done
            unit_active waybar || die "waybar.service is not active"
            [ -n "$(pids_of waybar)" ] || die "no waybar process"
            unit_active "$WSEV_UNIT" || die "$WSEV_UNIT is not active"
            [ -L "$HOME_DIR/.local/bin/nm-applet" ] && [ "$(readlink -f -- "$HOME_DIR/.local/bin/nm-applet")" = "$(readlink -f -- "$INST/bin/nm-applet")" ] \
                || die "$HOME_DIR/.local/bin/nm-applet does not resolve to the installed shim"
            if [ -n "$NMA_RESTARTED" ]; then
                for i in $(seq 1 30); do [ -n "$(pids_of nm-applet)" ] && break; sleep 0.1; done
                i="$(pids_of nm-applet | head -n1)"
                [ -n "$i" ] || die "nm-applet did not come back through the shim"
                ! proc_argv "$i" | grep -qx -- --indicator || die "nm-applet (pid $i) still runs with --indicator"
                log "nm-applet-secret-agent-ok"
            fi
            ;;
        gtk) verify_gtk ;;
        fm) verify_fm ;;
        settings) verify_settings ;;
        idle) verify_idle ;;
        theme-auto) verify_theme_auto ;;
        display) verify_display ;;
        lock)
            [ -L "$LOCK_CONF" ] && [ "$(readlink -f -- "$LOCK_CONF")" = "$(readlink -f -- "$INST/lock/hyprlock.conf")" ] \
                || die "$LOCK_CONF does not resolve to the installed lock screen"
            grep -qE '^[[:space:]]*font_color[[:space:]]*=' "$LOCK_CONF" || die "no font_color line in $LOCK_CONF"
            lock_check "$LOCK_CONF" source
            log "lock-source-ok"
            ;;
        osd)
            for i in "${OSD_BINS[@]}"; do
                [ -L "$HOME_DIR/.local/bin/$i" ] && [ "$(readlink -f -- "$HOME_DIR/.local/bin/$i")" = "$(readlink -f -- "$INST/osd/$i")" ] \
                    || die "$HOME_DIR/.local/bin/$i does not resolve to the installed $i"
                [ -x "$HOME_DIR/.local/bin/$i" ] || die "$HOME_DIR/.local/bin/$i is not executable"
            done
            # the shim must hand the real binary the swaync hint (SL_DUNSTIFY_REAL: echo stands in for dunstify)
            e="$(SL_DUNSTIFY_REAL="$(type -P echo)" "$HOME_DIR/.local/bin/dunstify" -h string:x-dunst-stack-tag:verify)"
            [ "$e" = "-h string:x-canonical-private-synchronous:verify" ] || die "the dunstify shim printed '$e'"
            grep -q 'hl\.env("PATH"' "$CFG/hypr/seclegion-host.lua" 2>/dev/null \
                || log "osd: WARNING: the border component with the PATH line is not applied; Hyprland binds will not find ~/.local/bin/dunstify. Run: $PROG apply border"
            log "osd-shim-ok"
            ;;
    esac
}

cmd_apply() {
    local comp="${1:-}" id
    is_component "$comp" || usage
    if [ -e "$PENDING" ]; then
        die "$(cat "$PENDING") is not confirmed yet: confirm or roll back the previous change first ($PROG confirm | $PROG rollback --last)"
    fi
    if unit_active "$DEADMAN.timer" || unit_active "$DEADMAN.service"; then
        die "$DEADMAN is still armed or running: confirm or roll back the previous change first"
    fi
    preflight "$comp"
    if [ ! -f "$BACKUPS/baseline-0/rollback.sh" ]; then
        [ ! -e "$BACKUPS/baseline-0" ] || die "$BACKUPS/baseline-0 is incomplete; inspect it and remove it by hand"
        make_backup baseline-0 "${COMPONENTS[@]}" shared
        phase=none
    fi
    extend_baseline
    id="$(new_id "$comp")"
    make_backup "$id" "$comp"
    stage "$comp"
    phase=changed
    install_comp "$comp"
    reload_comp "$comp"
    arm_deadman "$id"
    verify_comp "$comp"
    phase=done
    log "applied $id. Check the desktop, then run: $PROG confirm   (automatic rollback in 120 s)"
}

# ---- confirm / rollback / prune ---------------------------------------------
cmd_confirm() {
    local id
    [ -f "$PENDING" ] || die "nothing to confirm (no unconfirmed apply)"
    id="$(cat "$PENDING")"
    [ ! -e "$BACKUPS/$id/ROLLBACK_STARTED" ] \
        || die "a rollback of $id has already started; NOT confirmed. Finish it: bash $BACKUPS/$id/rollback.sh"
    if unit_active "$DEADMAN.service"; then
        die "the dead-man rollback of $id is already running; NOT confirmed"
    fi
    systemctl --user stop "$DEADMAN.timer" || err "stopping $DEADMAN.timer failed (rc $?)"
    if unit_active "$DEADMAN.timer" || unit_active "$DEADMAN.service"; then
        die "$DEADMAN is still active after stopping it; $id is NOT confirmed and may still roll back"
    fi
    date -u +%FT%TZ > "$BACKUPS/$id/CONFIRMED"
    chmod 600 "$BACKUPS/$id/CONFIRMED"
    rm -f -- "$PENDING"
    log "confirmed $id; dead-man disarmed"
}

cmd_rollback() {
    local arg="${1:---last}" id p
    case "$arg" in
        --last)
            id="$(list_ids | tail -n1)"
            [ -n "$id" ] || die "no apply backups in $BACKUPS (baseline-0 is rolled back by name)"
            ;;
        *) id="$arg" ;;
    esac
    { [[ "$id" =~ $ID_RE ]] || [ "$id" = baseline-0 ]; } || die "not a backup id: $id"
    [ -f "$BACKUPS/$id/rollback.sh" ] || die "no backup $id in $BACKUPS"
    if [ -f "$PENDING" ]; then
        p="$(cat "$PENDING")"
        { [ "$id" = "$p" ] || [ "$id" = baseline-0 ]; } \
            || die "$p is not confirmed yet: confirm or roll back the previous change first"
    fi
    if unit_active "$DEADMAN.service"; then die "the dead-man rollback is running right now; let it finish"; fi
    exec bash "$BACKUPS/$id/rollback.sh"
}

cmd_prune() {
    local ids i keep p=""
    { [ "${1:-}" = --keep ] && [[ "${2:-}" =~ ^[0-9]+$ ]]; } || usage
    keep="$2"
    mapfile -t ids < <(list_ids)
    [ ! -f "$PENDING" ] || p="$(cat "$PENDING")"
    for ((i = 0; i < ${#ids[@]} - keep; i++)); do
        [ "${ids[$i]}" != "$p" ] || continue
        rm -rf -- "${BACKUPS:?}/${ids[$i]}"
        log "pruned ${ids[$i]}"
    done
    log "kept baseline-0 and the newest $keep backup(s)"
}

# ---- --system: the packaged components onto a new user's home ---------------------
SYS_COMPONENTS=(notifications waybar gtk fm settings osd idle theme-auto)
VREPO=""

# A virtual repo (desktop/ and tools/ as the stage_* functions expect) copied from the packaged trees.
sys_build_repo() {
    local r="${SYS_ROOT%/}" v="$VREPO" f c
    local sh="$r/usr/share/seclegion" py="$r/usr/lib/seclegion/python" need=()
    for f in waybar/{config.jsonc,style.css,nm-applet,seclegion-ws,seclegion-wsevents,seclegion-wsevents.service,seclegion-vpn,seclegion-sec,seclegion-gpu,seclegion-uptime,seclegion-dnd,seclegion-ai,seclegion-sysmon,seclegion-wifi} \
        swaync/{config.json,style.css} idle/{hypridle.conf.in,seclegion-autolock,seclegion-idle.service,seclegion-idle-inhibit.service} \
        osd/{dunstify,seclegion-osd} fm/{dolphinrc.part,thunar.xml,yazi/init.lua.part,yazi/plugins/seclegion-space.yazi/main.lua} \
        theme/{tokens.toml,systemd/seclegion-theme-sync.path,systemd/seclegion-theme-sync.service} branding/seclegion-logo.png; do
        need+=("$sh/$f")
    done
    need+=("$py/seclegion_theme" "$py/seclegion_settings" "$r/usr/share/applications/seclegion-settings.desktop")
    for f in seclegion-set seclegion-settings seclegion-root-apply seclegion-theme seclegion-theme-pick seclegion-doctor; do need+=("$r/usr/bin/$f"); done
    for f in "${need[@]}"; do [ -e "$f" ] || die "missing packaged file $f (are seclegion-desktop, -theme, -settings and -branding installed under $SYS_ROOT?)"; done
    mkdir -p -- "$v/desktop/theme" "$v/desktop/settings" "$v/desktop/branding" "$v/tools"
    for c in waybar swaync idle osd fm; do cp -r -- "$sh/$c" "$v/desktop/$c"; done
    cp -r -- "$py/seclegion_theme" "$sh/theme/tokens.toml" "$sh/theme/systemd" "$v/desktop/theme/"
    cp -r -- "$py/seclegion_settings" "$r/usr/share/applications/seclegion-settings.desktop" "$v/desktop/settings/"
    cp -- "$sh/branding/seclegion-logo.png" "$v/desktop/branding/"
    for f in seclegion-set seclegion-settings seclegion-root-apply seclegion-theme seclegion-theme-pick seclegion-doctor; do cp -- "$r/usr/bin/$f" "$v/tools/"; done
}

sys_preflight() {
    local f c
    for f in luac python3 tar sha256sum; do command -v "$f" >/dev/null || die "$f is not installed"; done
    for c in "${SYS_COMPONENTS[@]}"; do
        case "$c" in
            notifications) link_or_absent "$CFG/swaync" ;;
            waybar) link_or_absent "$CFG/waybar"; link_or_absent "$HOME_DIR/.local/bin/nm-applet" ;;
            idle) preflight_idle ;;
            theme-auto) preflight_theme_auto ;;
            gtk | fm | settings) preflight_files "$c" ;;
            osd) for f in "${OSD_BINS[@]}"; do link_or_absent "$HOME_DIR/.local/bin/$f"; done ;;
        esac
    done
}

sys_enable() {   # what `systemctl --user enable` does for a WantedBy=default.target unit
    mkdir -p -- "$CFG/systemd/user/default.target.wants"
    ln -sfn -- "../$1" "$CFG/systemd/user/default.target.wants/$1"
}

sys_link_is() {   # LINK TARGET: LINK is a symlink resolving to the same file as TARGET
    [ -L "$1" ] && [ "$(readlink -f -- "$1")" = "$(readlink -f -- "$2")" ] && [ -e "$1" ]
}

# File-only checks: nothing live exists at install time. gtk, fm and settings have file-only verifies already.
verify_system() {
    local c f
    for c in "${SYS_COMPONENTS[@]}"; do
        case "$c" in
            gtk | fm | settings) verify_comp "$c" ;;
            notifications)
                { sys_link_is "$CFG/swaync" "$INST/notifications" && [ -s "$CFG/swaync/config.json" ]; } \
                    || die "$CFG/swaync does not resolve to the installed swaync config"
                ;;
            waybar)
                { sys_link_is "$CFG/waybar" "$INST/waybar" && [ -s "$CFG/waybar/config.jsonc" ]; } \
                    || die "$CFG/waybar does not resolve to the installed waybar config"
                sys_link_is "$HOME_DIR/.local/bin/nm-applet" "$INST/bin/nm-applet" || die "the nm-applet shim is not installed"
                { [ -f "$CFG/systemd/user/$WSEV_UNIT" ] && sys_link_is "$CFG/systemd/user/default.target.wants/$WSEV_UNIT" "$CFG/systemd/user/$WSEV_UNIT"; } \
                    || die "$WSEV_UNIT is not installed and enabled"
                ;;
            osd)
                for f in "${OSD_BINS[@]}"; do
                    { sys_link_is "$HOME_DIR/.local/bin/$f" "$INST/osd/$f" && [ -x "$HOME_DIR/.local/bin/$f" ]; } \
                        || die "$HOME_DIR/.local/bin/$f does not resolve to the installed $f"
                done
                ;;
            idle)
                for f in "$IDLE_INHIBIT_UNIT" "$IDLE_UNIT"; do
                    { [ -f "$CFG/systemd/user/$f" ] && grep -qF "$MARK_IDLE" "$CFG/systemd/user/$f"; } || die "$f is missing or not ours"
                done
                { sys_link_is "$HOME_DIR/.local/bin/seclegion-autolock" "$INST/idle/seclegion-autolock" && [ -x "$INST/idle/seclegion-autolock" ]; } \
                    || die "seclegion-autolock does not resolve to the installed copy"
                ;;
            theme-auto)
                for f in "$TA_PATH_UNIT" "$TA_UNIT"; do
                    { [ -f "$CFG/systemd/user/$f" ] && grep -qF 'seclegion-host:managed theme-auto' "$CFG/systemd/user/$f"; } || die "$f is missing or not ours"
                done
                sys_link_is "$CFG/systemd/user/default.target.wants/$TA_PATH_UNIT" "$CFG/systemd/user/$TA_PATH_UNIT" || die "$TA_PATH_UNIT is not enabled"
                python3 -I -B "$INST/theme-auto/seclegion-theme" --help >/dev/null || die "the installed seclegion-theme launcher does not run"
                ;;
        esac
    done
    theme_ok || die "$THEME_DIR is not a symlink to a complete theme"
    log "system-ok"
}

sys_refuse_live_home() {
    local b0="$BACKUPS/baseline-0"
    if [ -e "$b0" ] && ! grep -qx 'SL_SYSTEM_BACKUP=1' "$b0/rollback.sh" 2>/dev/null; then
        die "$HOME_DIR has $b0 from a live apply: this is not a new user's home; refusing"
    fi
    [ ! -e "$PENDING" ] || die "$PENDING exists: this is not a new user's home; refusing"
    { [ ! -e "$CFG/hyprland-dotfiles" ] && [ ! -L "$CFG/hyprland-dotfiles" ]; } \
        || die "$CFG/hyprland-dotfiles exists: this is the owner's home, not a new user's; refusing"
}

sys_applied() {   # an unrolled-back --system apply is in force
    local last
    { [ -f "$BACKUPS/baseline-0/rollback.sh" ] && grep -qx 'SL_SYSTEM_BACKUP=1' "$BACKUPS/baseline-0/rollback.sh" \
        && [ ! -e "$BACKUPS/baseline-0/ROLLED_BACK" ]; } || return 1
    last="$(list_ids | grep -- '-system$' | tail -n1 || true)"
    [ -n "$last" ] && [ ! -e "$BACKUPS/$last/ROLLED_BACK" ]
}

cmd_system() {
    local id c
    unset HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY   # never reach a session from here
    [ -d "$HOME_DIR" ] || die "$HOME_DIR does not exist"
    sys_refuse_live_home
    if sys_applied; then
        log "already applied to $HOME_DIR (no-op; run '$PROG rollback baseline-0' first to apply again)"
        return 0
    fi
    VREPO="$(mktemp -d)"
    trap 'rm -rf -- "$VREPO"' EXIT
    REPO="$VREPO"
    sys_build_repo
    sys_preflight
    mkdir -p -- "$CFG" "$HOME_DIR/.local/bin"   # a fresh home has neither
    if [ ! -f "$BACKUPS/baseline-0/rollback.sh" ]; then
        [ ! -e "$BACKUPS/baseline-0" ] || die "$BACKUPS/baseline-0 is incomplete; inspect it and remove it by hand"
        make_backup baseline-0 "${COMPONENTS[@]}" shared
        phase=none
    fi
    extend_baseline
    id="$(new_id system)"
    make_backup "$id" "${SYS_COMPONENTS[@]}"
    phase=changed
    for c in "${SYS_COMPONENTS[@]}"; do
        stage "$c"
        install_comp "$c"
        case "$c" in
            waybar) sys_enable "$WSEV_UNIT" ;;
            theme-auto) sys_enable "$TA_PATH_UNIT" ;;
        esac
    done
    verify_system
    phase=done
    rm -f -- "$BACKUPS/baseline-0/ROLLED_BACK"
    [ -e "$CFG/hypr/hyprland.lua" ] || log "warning: $CFG/hypr/hyprland.lua is missing; copy /etc/skel/.config/hypr from seclegion-dotfiles"
    log "applied $id to $HOME_DIR. Undo: $PROG rollback --last   (or baseline-0)"
}

if [ -n "$SL_SYSTEM_BACKUP" ]; then
    cmd_system
    exit 0
fi

case "${1:-}" in
    apply) shift; cmd_apply "$@" ;;
    confirm) cmd_confirm ;;
    rollback) shift; cmd_rollback "$@" ;;
    prune) shift; cmd_prune "$@" ;;
    *) usage ;;
esac
