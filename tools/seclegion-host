    # REUSE-IgnoreStart
    printf '/* SPDX-License-Identifier: MIT */\n/* %s: written by seclegion-host apply gtk; rollback removes it. */\n@import url("file://%s/gtk3.css");\n' \
        "$MARK_GTK3" "$cur" > "$css3"
    # REUSE-IgnoreEnd
    # GTK 4 / libadwaita: a real directory in place of the symlink into ~/.themes
    old="$(gtk4_old_target)"
    if [ -n "$old" ]; then
        oldabs="$old"
        [[ "$old" == /* ]] || oldabs="$CFG/$old"
    fi
    rm -rf -- "$tmp"
    mkdir -- "$tmp"
    printf '# seclegion-host: this directory replaced a symlink; rollback removes it and restores the link.\nold_target=%s\n' "$old" > "$tmp/.seclegion-managed"
    if [ -n "$oldabs" ] && [ -d "$oldabs" ]; then
        shopt -s nullglob dotglob
        for e in "$oldabs"/*; do
            e="${e##*/}"
            case "$e" in gtk.css | gtk-dark.css | .seclegion-managed) continue ;; esac
            ln -s -- "$oldabs/$e" "$tmp/$e"   # a link to the old target's subpath: nothing is copied from or into ~/.themes
        done
        shopt -u nullglob dotglob
    fi
    for e in gtk.css gtk-dark.css; do
        # gtk-dark.css is generated too: GTK 4 reads it in place of gtk.css under a dark preference
        if [ "$e" = gtk-dark.css ] && { [ -z "$oldabs" ] || [ ! -f "$oldabs/gtk-dark.css" ]; }; then continue; fi
        {
            # REUSE-IgnoreStart
            printf '/* SPDX-License-Identifier: MIT */\n/* seclegion-host:managed gtk4: the old theme, then the SecLegion tokens. */\n'
            # REUSE-IgnoreEnd
            if [ -n "$oldabs" ] && [ -f "$oldabs/$e" ]; then printf '@import url("file://%s/%s");\n' "$oldabs" "$e"; fi
            printf '@import url("file://%s/gtk4.css");\n' "$cur"
        } > "$tmp/$e"
    done
    if [ -L "$g4" ]; then rm -f -- "$g4"; elif [ -e "$g4" ]; then rm -rf -- "$g4"; fi
    mv -T -- "$tmp" "$g4"
    # Qt / KDE: colour-scheme symlinks into the live theme; qt6ct's own qt6ct.conf is never touched
    mkdir -p -- "$HOME_DIR/.local/share/color-schemes" "$CFG/qt6ct/colors"
    ln -sfn -- "$cur/kde.colors" "$HOME_DIR/.local/share/color-schemes/SecLegion.colors"
    ln -sfn -- "$cur/qt6ct.conf" "$CFG/qt6ct/colors/SecLegion.conf"
    ini_set "$CFG/kdeglobals" General ColorScheme=SecLegion
    log "gtk: GTK 3/4, KDE and qt6ct colour scheme linked into $cur; running apps pick it up on their next start"
    log "qt6ct opt-in (yours to do; your own qt6ct.conf is untouched and the kvantum style stays): Appearance > Palette > Custom, then pick SecLegion"
}

