# Triggered only by seclegion-kiosk.service (OnFailure=). Shows the error screen and the log path.
[Unit]
Description=SecLegion installer kiosk error screen

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/share/seclegion/kiosk/error
