# Rescue mode only (wanted by seclegion-rescue.target): a root shell on tty1. This is the one
# autologin on the ISO; root's password stays locked (!*).
[Unit]
Description=SecLegion rescue root shell on tty1
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=idle
ExecStart=-/usr/bin/agetty --noreset --noclear --autologin root - ${TERM}
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
Restart=always
UtmpIdentifier=tty1
