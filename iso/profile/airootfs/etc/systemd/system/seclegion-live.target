# The GRUB entry boots to this target (systemd.unit=).
[Unit]
Description=SecLegion OS (live mode)
# basic.target only: the slow multi-user services (network, cloud-init) start in parallel, so the
# target and its marker do not wait for them.
Requires=basic.target
After=basic.target
Wants=multi-user.target
Wants=seclegion-mode@live.service
AllowIsolate=yes
Wants=greetd.service
Wants=seclegion-selftest.service
