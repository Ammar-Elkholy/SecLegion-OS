[Desktop Entry]
Type=Application
Name=System Monitor
GenericName=System Monitor
Comment=CPU, memory, disks, network, GPUs and processes
Exec=seclegion-sysmon
Icon=utilities-system-monitor
Terminal=false
Categories=System;Monitor;
Keywords=cpu;memory;gpu;processes;monitor;task manager;
StartupNotify=true
StartupWMClass=org.seclegion.Sysmon
