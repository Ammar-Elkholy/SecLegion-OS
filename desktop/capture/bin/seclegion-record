#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 Ammar Elkholy and SecLegion contributors
# SPDX-License-Identifier: MIT
"""seclegion-record [region|screen] toggle: start a wf-recorder capture into
~/Videos/Recordings/*.mp4, or, when one started by this tool is running, stop it. The pid and
output path live in $XDG_RUNTIME_DIR/seclegion-record.pid; only that pid is ever signalled.

Env (tests): SL_RECORDER (default wf-recorder), SL_SLURP, SL_NOTIFY, SL_RECORD_DIR.
"""
import datetime
import os
import pathlib
import shlex
import signal
import subprocess
import sys
import time


def cmd(var, default):
    return shlex.split(os.environ.get(var, default))


def notify(title, body=""):
    subprocess.run(cmd("SL_NOTIFY", "notify-send") + ["-a", "seclegion-capture", title, body], check=False)


def pidfile():
    return pathlib.Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "seclegion-record.pid"


def state(pid):
    return pathlib.Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0]


def running():
    """Return (pid, path) of our live recorder, else None (a stale pidfile is removed)."""
    pf = pidfile()
    try:
        pid_s, path = pf.read_text().split("\n")[:2]
        pid = int(pid_s)
        comm = pathlib.Path(f"/proc/{pid}/cmdline").read_bytes()
        if os.path.basename(cmd("SL_RECORDER", "wf-recorder")[0]).encode() not in comm:
            raise ValueError("pid reused")
        if state(pid) == "Z":
            raise ValueError("zombie")
        return pid, path
    except (OSError, ValueError):
        pf.unlink(missing_ok=True)
        return None


def stop(pid, path):
    os.kill(pid, signal.SIGINT)  # wf-recorder finalizes the mp4 on SIGINT
    for _ in range(100):
        try:
            if state(pid) == "Z":
                break
        except OSError:
            break
        time.sleep(0.1)
    pidfile().unlink(missing_ok=True)
    notify("Recording saved", path)


def main(argv):
    mode = next((a for a in argv if a in ("region", "screen")), "screen")
    cur = running()
    if cur:
        stop(*cur)
        return 0
    geom = []
    if mode == "region":
        r = subprocess.run(cmd("SL_SLURP", "slurp"), capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.strip():
            return 0
        geom = ["-g", r.stdout.strip()]
    d = pathlib.Path(os.environ.get("SL_RECORD_DIR") or pathlib.Path.home() / "Videos/Recordings")
    d.mkdir(parents=True, exist_ok=True)
    out = d / datetime.datetime.now().strftime("recording-%Y%m%d-%H%M%S.mp4")
    p = subprocess.Popen(cmd("SL_RECORDER", "wf-recorder") + geom + ["-f", str(out)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    pidfile().write_text(f"{p.pid}\n{out}\n")
    notify("Recording started", f"{out}\nRun the same shortcut again to stop")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
