// SecLegion OS bar. Colours live in style.css (theme tokens), not here.
// GENERATED from config.jsonc.in by tools/gen-waybar-ws: edit the .in file, not this one.
{
  "layer": "top",
  "position": "top",
  "height": 36,
  "exclusive": true,
  "passthrough": false,
  "spacing": 4,

  "modules-left": ["custom/launcher", "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10", "custom/ws11", "custom/ws12", "custom/ws13", "custom/ws14", "custom/ws15", "custom/ws16", "custom/ws17", "custom/ws18", "custom/ws19", "custom/ws20", "hyprland/submap"],
  "modules-center": ["mpris#sl-media"],
  "modules-right": ["group/sl-stats", "custom/sl-vpn", "custom/sl-ai", "network", "bluetooth", "pulseaudio", "custom/sl-display", "backlight", "power-profiles-daemon", "battery", "custom/notification", "hyprland/language", "tray", "clock"],

  "custom/launcher": {
    "format": " ",
    "tooltip-format": "SecLegion OS - applications",
    "on-click": "rofi -show drun"
  },

  // Workspace pills (generated by tools/gen-waybar-ws; edit config.jsonc.in).
  "custom/ws1": {
    "exec": "cat \"$XDG_RUNTIME_DIR/seclegion/ws/1.json\" 2>/dev/null || echo '{\"text\":\"\",\"class\":\"hidden\"}'",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })'",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
