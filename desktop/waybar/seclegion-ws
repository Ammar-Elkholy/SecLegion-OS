"""seclegion-ws N - one waybar workspace pill, as waybar custom-module JSON.

Prints {"text":"N","class":"active|occupied|empty|urgent"}, or
{"text":"","class":"hidden"} when workspace N does not exist and is not
persistent (Hyprland lists persistent workspaces in `workspaces -j` even when
empty, so one query covers both). Waybar hides a module whose text is empty.

Why this exists: Waybar 0.15.0 sends the legacy `dispatch workspace N` string,
which Hyprland 0.56 in Lua mode rejects, so the built-in hyprland/workspaces
module cannot switch workspaces. Our pills dispatch the Lua form themselves.

Reads `hyprctl workspaces -j` and `hyprctl activeworkspace -j`. Urgent comes from
the addresses seclegion-wsevents keeps in a state file (Hyprland's JSON has no
urgent flag); `hyprctl clients -j` maps them to workspaces, only if any exist.

The bar does not run this per pill: seclegion-wsevents imports snapshot() and
classify() from here, renders every pill from one snapshot into files the
modules read. This command stays as the one-pill CLI (tests/ws/click.sh).

Environment (for tests): SL_HYPRCTL = the hyprctl command (default "hyprctl"),
SL_WS_URGENT = the urgent-addresses state file.
"""
import json
import os
import shlex
import subprocess
import sys

HIDDEN = {"text": "", "class": "hidden"}


def urgent_path():
    return os.environ.get("SL_WS_URGENT") or os.path.join(
        os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "seclegion", "ws-urgent"
    )


def hyprctl(*args):
    cmd = shlex.split(os.environ.get("SL_HYPRCTL", "hyprctl")) + list(args)
    out = subprocess.run(cmd, capture_output=True, text=True, timeout=5, check=True).stdout
    return json.loads(out)


def urgent_addresses():
    try:
        with open(urgent_path()) as fh:
            return {ln.strip().lower().removeprefix("0x") for ln in fh if ln.strip()}
    except OSError:
        return set()


def classify(n, workspaces, active_id, urgent_ids):
    ws = next((w for w in workspaces if w.get("id") == n), None)
    if ws is None:
        return HIDDEN
    if n == active_id:
        cls = "active"
    elif n in urgent_ids:
        cls = "urgent"
    elif ws.get("windows", 0) > 0:
        cls = "occupied"
    else:
        cls = "empty"
    return {"text": str(n), "class": cls}


def snapshot():
    """(workspaces, active id, urgent workspace ids) from one round of hyprctl."""
    workspaces = hyprctl("workspaces", "-j")
    active_id = hyprctl("activeworkspace", "-j").get("id")
    urgent_ids = set()
    addrs = urgent_addresses()
    if addrs:
        for c in hyprctl("clients", "-j"):
            if c.get("address", "").lower().removeprefix("0x") in addrs:
                urgent_ids.add(c.get("workspace", {}).get("id"))
    return workspaces, active_id, urgent_ids


def main(argv):
    if len(argv) != 2 or not argv[1].isdigit() or int(argv[1]) < 1:
        print("usage: seclegion-ws N   (N >= 1)", file=sys.stderr)
        return 2
    n = int(argv[1])
    try:
        result = classify(n, *snapshot())
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        # Hyprland is away or restarting: hide the pill, the next signal redraws it.
        print(f"seclegion-ws: {e}", file=sys.stderr)
        result = HIDDEN
    print(json.dumps(result, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
