# SPDX-FileCopyrightText: 2026 Ammar Elkholy and SecLegion contributors
# SPDX-License-Identifier: MIT
# Bar click target for the Wi-Fi panel. seclegion-host stages this into host/bin; when it also
# staged host/bin/python/seclegion_wifi (a live laptop before the package is installed) that copy runs,
# otherwise the packaged /usr/bin/seclegion-wifi does.
here=$(dirname "$(readlink -f "$0")")
if [ -d "$here/python/seclegion_wifi" ]; then
    PYTHONPATH="$here/python${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m seclegion_wifi "$@"
fi
exec /usr/bin/seclegion-wifi "$@"
