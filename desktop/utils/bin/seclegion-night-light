#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Ammar Elkholy and SecLegion contributors
# SPDX-License-Identifier: MIT
# seclegion-night-light [toggle|on|off|status] [KELVIN]: warm the screen with hyprsunset
# (default 4000 K). The running hyprsunset is tracked by a pid file, so on/off are idempotent.
# Env (tests): SL_STATE_DIR, SL_SUNSET (default hyprsunset), SL_NOTIFY.
set -u
dir="${SL_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/seclegion}"
pidf="$dir/night-light.pid"
sunset="${SL_SUNSET:-hyprsunset}"
notify="${SL_NOTIFY:-notify-send}"
temp="${2:-4000}"
running() { [ -r "$pidf" ] && p="$(cat "$pidf")" && [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }
say() { "$notify" -a SecLegion "Night light" "$1" >/dev/null 2>&1 || true; }
on() {
    running && return 0
    mkdir -p "$dir"
    "$sunset" -t "$temp" >/dev/null 2>&1 &
    echo $! > "$pidf"
    say "On (${temp} K)"
}
off() {
    if running; then kill "$p" 2>/dev/null || true; fi
    rm -f "$pidf"
    say "Off"
}
case "${1:-toggle}" in
    on) on ;;
    off) off ;;
    status) if running; then echo on; else echo off; fi ;;
    toggle) if running; then off; else on; fi ;;
    *) echo "usage: seclegion-night-light [toggle|on|off|status] [KELVIN]" >&2; exit 2 ;;
esac
