[Desktop Entry]
Type=Application
Name=SecLegion Settings
GenericName=Settings
Comment=Power, display, sound, network and appearance settings for SecLegion
Exec=seclegion-settings
Icon=preferences-system
Terminal=false
Categories=Settings;System;
Keywords=settings;preferences;power;battery;display;sound;network;theme;
StartupNotify=true
StartupWMClass=org.seclegion.Settings
